# Sanity project that holds the blog posts (sanity.io/manage).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Only needed to run scripts/migrate-blog-to-sanity.ts. Editor token from the API tab.
SANITY_WRITE_TOKEN=

# ---- Site editor (/edit) -----------------------------------------------------
# See "Site editor" in README.md. Set these on Vercel (Production) as runtime
# variables; locally, put them in .env.local.

# Boat API key (boat.dev dashboard → API keys).
BOAT_API_KEY=
# Fine-grained GitHub token for show-karma/filecoin-grants only, with
# Contents: read & write and Pull requests: read & write.
GITHUB_TOKEN=
# The password the customer signs in with at /edit. 12+ random characters:
# it guards publishing to the live site. Changing it signs everyone out.
EDITOR_PASSWORD=
# Random string that signs the sign-in cookie: `openssl rand -base64 32`.
EDITOR_SESSION_SECRET=

# Optional. Defaults shown.
# EDITOR_AGENT_PROVIDER=claude      # claude, codex, pi, opencode, ...
# EDITOR_AGENT_MODEL=               # empty: the model chosen on Boat's dashboard
# BOAT_TEMPLATE=filpgf-editor       # saved snapshot sessions start from
# BOAT_ENVIRONMENT=filpgf-editor    # Boat environment sessions run in
# GITHUB_REPO=show-karma/filecoin-grants
# EDITOR_PUBLISH_MODE=merge         # merge: Publish goes live. review: opens a PR for a developer.
# Quick (small, pointed) vs deep (structural) requests. Effort: none|low|medium|high|xhigh|max.
# EDITOR_EFFORT_QUICK=low
# EDITOR_EFFORT_DEEP=high
# EDITOR_MODEL_QUICK=               # empty: EDITOR_AGENT_MODEL, else Boat's default
# EDITOR_MODEL_DEEP=
# Wording-only requests skip the agent: a fast model rewrites the page's text
# directly (about 2 seconds). Runs in the sandbox with Boat's Anthropic key.
# EDITOR_FAST_MODEL=claude-haiku-5-5  # "off" sends everything to the agent
# Local testing only: point the editor at stand-ins for Boat and GitHub.
# BOAT_API_BASE=
# GITHUB_API_BASE=
