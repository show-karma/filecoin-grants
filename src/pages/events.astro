---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import PageHero from "../components/PageHero.astro";
import { UPCOMING_EVENTS } from "../data/events";
---

<BaseLayout
  title="Events"
  description="Upcoming events from the Filecoin Public Goods Funding team."
  breadcrumb="Events"
>
  <PageHero
    eyebrow="Events"
    title="Events"
    intro="Where to find us next — talks, community calls and meetups from the Filecoin Public Goods Funding team."
  />

  <Section id="upcoming">
    {
      UPCOMING_EVENTS.length > 0 ? (
        <ul class="divide-y divide-line border-y border-line">
          {UPCOMING_EVENTS.map((event) => (
            <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6">
              <span class="mono-meta shrink-0 sm:w-40">{event.date}</span>
              <a
                href={event.href}
                class="text-lg font-medium text-ink hover:underline"
                target={event.href.startsWith("http") ? "_blank" : undefined}
                rel={
                  event.href.startsWith("http")
                    ? "noopener noreferrer"
                    : undefined
                }
              >
                {event.name}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-body">Event details coming soon.</p>
      )
    }
  </Section>

  <Section id="usd-brl" tint>
    <h2 class="text-2xl sm:text-3xl">USD/BRL</h2>
    <p class="mt-2 text-sm text-body">
      Live exchange rate, refreshed every 5 seconds.
    </p>
    <div
      data-usdbrl-rate
      class="mt-6 rounded-lg border border-line bg-surface p-6 sm:p-7"
    >
      <p class="text-body">Loading…</p>
    </div>
  </Section>
</BaseLayout>

<script>
  const container = document.querySelector<HTMLDivElement>(
    "[data-usdbrl-rate]",
  );

  const fetchRate = async () => {
    if (!container) return;
    try {
      const res = await fetch(
        "https://economia.awesomeapi.com.br/json/last/USD-BRL",
      );
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      const quote = data.USDBRL;
      const bid = Number(quote.bid).toFixed(4);
      const ask = Number(quote.ask).toFixed(4);
      const updated = new Date(
        Number(quote.timestamp) * 1000,
      ).toLocaleTimeString();
      container.innerHTML = `
        <dl class="grid grid-cols-2 gap-4 sm:grid-cols-3">
          <div>
            <dt class="mono-meta uppercase">Bid</dt>
            <dd class="mt-1.5 text-lg font-semibold text-ink">R$ ${bid}</dd>
          </div>
          <div>
            <dt class="mono-meta uppercase">Ask</dt>
            <dd class="mt-1.5 text-lg font-semibold text-ink">R$ ${ask}</dd>
          </div>
          <div>
            <dt class="mono-meta uppercase">Updated</dt>
            <dd class="mt-1.5 text-lg font-semibold text-ink">${updated}</dd>
          </div>
        </dl>
      `;
    } catch {
      container.innerHTML = `<p class="text-body">Could not load the exchange rate.</p>`;
    }
  };

  fetchRate();
  setInterval(fetchRate, 5000);
</script>
