---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import DarkCallout from "../components/DarkCallout.astro";
import CriteriaList from "../components/CriteriaList.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import ArrowLink from "../components/ArrowLink.astro";
import TierOverview from "../components/kernel/TierOverview.astro";
import TierCard from "../components/kernel/TierCard.astro";
import Timeline from "../components/kernel/Timeline.astro";
import Glossary from "../components/kernel/Glossary.astro";
import InventoryPanel from "../components/kernel/InventoryPanel.astro";
import MetricGrid from "../components/kernel/MetricGrid.astro";
import { TIERS, NEXT_ROUND } from "../data/kernel";
import { loadKernelData } from "../data/kernel-api";
import { PROGRAM_PROJECTS_URL } from "../data/site";

/*
 * Rendered on demand rather than at build so the inventory can refresh without
 * a deploy; Vercel ISR then caches the result, so the 17 upstream requests
 * below are paid per regeneration, not per visitor.
 */
export const prerender = false;

/*
 * `kernelData` is null when the Kernel API could not be read for this render.
 * The page then keeps only what is true without it — the tier definitions, the
 * program's terms, the glossary — and drops every figure, section and nav entry
 * that would otherwise state something it cannot evidence. A half-populated
 * inventory would be worse than none: it would read as "these are the
 * commitments" while quietly omitting most of them.
 *
 * Now that the read happens per render, that degraded page is cacheable: an API
 * outage during a regeneration can hold the inventory-less version in front of
 * visitors for a full expiration window.
 */
const kernelData = await loadKernelData();
const nav = [
  { label: "Objective", href: "#objective" },
  /* The section has always been here; only the link to it was missing. */
  { label: "Timeline", href: "#timeline" },
  { label: "Categories", href: "#categories" },
  ...(kernelData
    ? [
        { label: "Inventory", href: "#inventory" },
        { label: "Metrics", href: "#metrics" },
      ]
    : []),
  { label: "Terms", href: "#terms" },
];

/*
 * The tier cards carry a function count, so it is injected from the API like
 * every other figure on the page rather than kept alongside the copy. Without
 * live data each card reads "inventory pending", which is the truth: we do not
 * know how many there are right now.
 */
const tierCards = TIERS.map((tier) => ({
  ...tier,
  functions:
    kernelData?.tiers.find((row) => row.tier === tier.apiId)?.catalogued ||
    null,
}))
  /*
   * A tier with nothing catalogued is not explained here, for the same reason
   * it is not tabled above: `nice-to-have` describes a shape of work the
   * programme has never funded, and a card defining it sends a reader to an
   * inventory section that has nothing in it. Keyed on the served count, so
   * the card returns by itself once a function lands in the tier — and an
   * unreachable API leaves every count null and every card in place.
   */
  .filter(
    (tier) =>
      !kernelData ||
      (kernelData.tiers.find((row) => row.tier === tier.apiId)?.catalogued ??
        1) > 0,
  );

/** "Four tiers" was a constant while the page always drew four. */
const TIER_COUNT_WORD: Record<number, string> = {
  1: "One tier",
  2: "Two tiers",
  3: "Three tiers",
  4: "Four tiers",
};
const tiersTitle = `${TIER_COUNT_WORD[tierCards.length] ?? `${tierCards.length} tiers`}, set by what happens without it`;

const KERNEL_FUNDS = [
  "Maintenance of functions the network cannot operate without",
  "A second implementation where a single one is a systemic risk",
  "Monitoring, testnets, and incident response that keep the network observable",
  "Security and upgrade work required to stay production-safe",
];

const KERNEL_DOES_NOT_FUND = [
  "New features or product expansion — that is Revenue Development",
  "Exploratory or unproven work — that is R&D",
  "Functions with no maintainer willing to report health metrics",
];
---

<BaseLayout
  title="Kernel"
  description="Kernel funds the functions Filecoin depends on to keep producing blocks, proving storage, and staying observable. It is treated as a near-fixed cost rather than a growth bet."
  nav={nav}
  cta={{ label: "Apply · FY27", href: NEXT_ROUND.ctaHref }}
  breadcrumb="Kernel"
  accent="kernel"
>
  <PageHero
    eyebrow="Kernel · Program overview"
    title="What keeps the network running."
    intro="Kernel funds the functions Filecoin depends on to keep producing blocks, proving storage, and staying observable. It is treated as a near-fixed cost rather than a growth bet: the goal is not more features, it is that nothing essential quietly stops being maintained."
  >
    <div class="mt-12">
      <TierOverview data={kernelData} />
    </div>
  </PageHero>

  <!-- Objective -->
  <Section id="objective">
    <SectionHeader eyebrow="Objective" title="Keep the floor from moving" />

    <div class="mt-8 grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="space-y-5 text-[0.95rem] leading-relaxed">
        <p>
          Most of what Filecoin runs on is maintained by small teams, and much
          of it has no second implementation. When one of those goes unfunded,
          nothing breaks on the day it happens — the repo just goes quiet, the
          maintainer moves on, and the network carries a dependency nobody is
          watching. Kernel exists to make that failure mode visible and to pay
          for it not to happen.
        </p>
        <p>
          The program starts from a map, not a wishlist. Every capability the
          network needs is written down as a <strong
            class="font-semibold text-ink">function</strong
          >, independent of which repo currently provides it. Each function is
          placed in a tier according to how replaceable it is, and each tier
          carries a different funding posture — some are non-negotiable, some
          are funded for redundancy, some are funded only for maintenance.
        </p>
        <p>
          Funding follows an annual term with audits rather than milestones,
          because keeping something working is a continuous obligation and not a
          deliverable. Teams are assessed against agreed metrics for resilience
          and operational continuity: is the function still healthy, still
          maintained, still measurable.
        </p>
        {
          kernelData && (
            <>
              <p>
                Every commitment on this page names a threshold, a reading
                cadence and a public endpoint anyone can call — so the audit is
                a lookup, not a conversation.
              </p>
              {/* The button is wrapped so the column's space-y sets its
                  spacing, rather than a margin utility racing space-y for the
                  same property. */}
              <div>
                <Button href="#inventory">See the inventory</Button>
              </div>
            </>
          )
        }
      </div>

      <div class="space-y-6 rounded-lg border border-line bg-surface p-6">
        <CriteriaList label="Kernel funds" items={KERNEL_FUNDS} tone="in" />
        <div class="border-t border-line-soft pt-6">
          <CriteriaList
            label="Kernel does not fund"
            items={KERNEL_DOES_NOT_FUND}
            tone="out"
          />
        </div>
      </div>
    </div>
  </Section>

  <!-- Timeline -->
  <Section id="timeline" tint>
    <SectionHeader
      eyebrow="Timeline"
      title="One term, two audits"
      intro="Kernel grants run on an annual term. Audits fall mid-term and at close, and each one checks the agreed resilience metrics rather than a feature list."
    />
    <div class="mt-8">
      <DarkCallout {...NEXT_ROUND} />
    </div>
    <div class="mt-10">
      <Timeline />
    </div>
  </Section>

  <!-- Categories -->
  <Section id="categories">
    <SectionHeader
      eyebrow="Categories"
      title={tiersTitle}
      intro="A function's tier is decided by substitutability, not by how much anyone likes it. That single judgement then drives how much scrutiny it gets, whether redundancy is required, and how negotiable the budget is."
    />
    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {tierCards.map((tier) => <TierCard tier={tier} />)}
    </div>
  </Section>

  <!-- Inventory -->
  {
    kernelData && (
      <Section id="inventory" tint>
        <InventoryPanel data={kernelData} />
      </Section>
    )
  }

  <!-- Metrics -->
  {
    kernelData && (
      <Section id="metrics">
        <SectionHeader
          eyebrow="Kernel metrics"
          title="How the program is doing"
          intro="Aggregate health matters less than coverage. A function with no maintainer and no metric is invisible to this page, which is exactly what makes it dangerous."
        />
        <div class="mt-10">
          <MetricGrid data={kernelData} />
        </div>
        <div class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <p class="text-sm text-muted">
            Every reading on this page is derived from the commitments in the
            Kernel registry.
          </p>
          <ArrowLink
            href={PROGRAM_PROJECTS_URL}
            label="Metrics for individual projects and repos live in the explorer"
          />
        </div>
      </Section>
    )
  }

  <!-- Terms -->
  <Section id="terms" tint>
    <SectionHeader
      eyebrow="Terms"
      title="What these words mean here"
      intro="Kernel uses a few words in a specific way. Getting them straight is most of understanding the program."
    />
    <div class="mt-10">
      <Glossary />
    </div>
  </Section>
</BaseLayout>
