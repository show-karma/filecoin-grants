---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import PostMeta from "../../components/PostMeta.astro";
import ArrowLink from "../../components/ArrowLink.astro";
import { ASK_KARMA } from "../../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout
  title="Blog"
  description="Program updates and spotlighted projects from Filecoin Public Goods Funding. New rounds, selection committees, and open calls get posted here first."
  cta={ASK_KARMA}
>
  <section class="bg-surface pt-14 pb-4 sm:pt-20">
    <div class="container-page">
      <div class="flex items-center gap-4">
        <span class="eyebrow shrink-0">From the blog</span>
        <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
      </div>
      <h1 class="mt-5 text-4xl sm:text-5xl">Follow along</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed">
        Track program updates and spotlighted projects. New rounds, selection
        committees, and open calls get posted here first.
      </p>
    </div>
  </section>

  <Section>
    {
      posts.length === 0 ? (
        <p class="rounded-lg border border-line bg-tint px-5 py-8 text-center text-body">
          No posts published yet. Check back soon.
        </p>
      ) : (
        <ul class="space-y-5">
          {posts.map((post) => (
            <li>
              <article class="rounded-lg border border-line bg-surface p-6 transition-colors hover:border-muted/40 sm:p-7">
                <PostMeta date={post.data.date} author={post.data.author} />
                <h2 class="mt-3 text-xl sm:text-2xl">
                  <a href={`/blog/${post.id}/`} class="hover:text-accent">
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-3 max-w-3xl text-[0.95rem] leading-relaxed">
                  {post.data.description}
                </p>
                <p class="mt-5">
                  <ArrowLink href={`/blog/${post.id}/`} label="Read the post" />
                </p>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </Section>
</BaseLayout>
