---
import BaseLayout from "../layouts/BaseLayout.astro";

const PARTNERS = [
  {
    n: 1,
    role: "Hosts & surfaces",
    name: "Karma",
    body: "Holds the program’s records: incoming applications and milestones, plus the reviews and metrics the loop produces, surfaced in admin queues, cover pages, and Ask Karma.",
    link: { label: "Admin views", href: "#admin-views" },
    pos: "top",
  },
  {
    n: 2,
    role: "Review",
    name: "Simocracy",
    body: "A sim drafts the first assessment of every application and milestone. A person reviews it and makes the call.",
    link: { label: "AI-native reviews", href: "#ai-native" },
    pos: "right",
  },
  {
    n: 3,
    role: "Measure",
    name: "OSO",
    body: "Tracks impact and maintenance for every funded project, and flags a stalled data source before anyone goes looking.",
    link: { label: "Impact tracking", href: "#impact-tracking" },
    pos: "left",
  },
];

const TRACKED = [
  ["Cover page with program-level and project-level metrics", true, true, true],
  ["Published health and maintenance metric per project", true, true, true],
  ["Automated monitoring for stale or failing data sources", true, true, true],
  [
    "Revenue-linked metric (paid usage, onchain revenue, or paying customers)",
    false,
    false,
    true,
  ],
] as const;

const TEAMS = [
  ["Ankr", "1 Essential", 3, 1],
  ["Blockscout", "2 Essential", 6, 2],
  ["Chain.Love", "1 Essential", 5, 1],
  ["Curio / FilOz", "3 Essential", 5, 3],
  ["drand / Randamu", "1 Irreplaceable · 1 Essential", 5, 2],
  ["Filecoin Community Services / ChainSafe", "3 Essential", 3, 3],
  ["Filecoin Data Portal", "1 Essential", 1, 1],
  ["Filecoin Docs / FIL-B", "1 Essential", 2, 1],
  ["Forest / ChainSafe", "2 Essential", 2, 2],
  ["Goldsky", "1 Essential", 2, 1],
  ["IPNI / OIF", "1 Essential", 4, 1],
  ["Plumbline", "1 Essential", 1, 1],
  ["USDFC / Secured Finance", "1 Important", 4, 1],
  ["Zondax", "1 Essential", 2, 1],
] as const;

const APP_STEPS = [
  ["Pre-filled application", "From information on file"],
  ["Team review", "Update and submit"],
  ["Sim assessment", "Sims evaluate"],
  ["Committee decision", "Humans decide"],
];
const MILESTONE_STEPS = [
  ["Milestone submitted", "Update filed in filpgf.io"],
  ["Sim assessment", "Assigned sim reviewer"],
  ["Human reviewer", "Notified, reminded, escalated"],
  ["Decision recorded", "Captured in filpgf.io"],
];

const FEEDS_IN = [
  ["Slack & Telegram", "Reviewer & project feedback"],
  ["OSO", "Impact & maintenance data"],
  ["Simocracy", "Sim reviews & feedback"],
];
const SURFACES_AS = [
  ["Public views", "Funding, projects, impact"],
  ["Project & reviewer views", "Status, reviews, invoices"],
  ["Admin queues", "Reviews & payments by priority"],
];

/* Bar widths are fractions of a three-week axis. */
const SLA = [
  {
    label: "Reviewer notified",
    sub: "of their sim’s assessment",
    solid: 1 / 15,
    dashed: 0,
    text: "within 1 business day",
  },
  {
    label: "Standard milestone review",
    sub: "no changes needed",
    solid: 1 / 3,
    dashed: 0,
    text: "within 1 week",
  },
  {
    label: "Review needing changes",
    sub: "or further discussion",
    solid: 1 / 3,
    dashed: 1 / 3,
    text: "2-week ceiling target",
  },
  {
    label: "Invoice payout",
    sub: "on a verified milestone",
    solid: 2 / 3,
    dashed: 0,
    text: "target 2-week window",
    inside: true,
  },
];

const FOLLOW_UPS = [
  [
    "Project follow-ups",
    "Overdue milestone updates get a nudge every 3 business days, then weekly after 10.",
  ],
  [
    "Reviewer follow-ups",
    "Pending reviews follow the same cadence, so nothing stalls quietly.",
  ],
  [
    "Admin queues",
    "Every application, milestone and invoice becomes a work item with a status and an age.",
  ],
];

const TAG_COLORS: Record<string, string> = {
  "Metrics & impact": "var(--color-ok)",
  Metrics: "var(--color-ok)",
  "Sims & reviews": "var(--color-warn)",
  Sims: "var(--color-warn)",
  Applications: "var(--color-bad)",
  Apps: "var(--color-bad)",
  "Admin operations": "var(--color-tier-essential)",
  Admin: "var(--color-tier-essential)",
  "UX & comms": "var(--color-tier-important)",
  Integrations: "var(--color-accent)",
};

const WINDOWS = [
  {
    dates: "Sep 1 – Oct 31, 2026",
    status: "In progress",
    title: "Funding framework, transparency & AI-native operations",
    items: [
      [
        "Funding metrics everywhere",
        "Metrics land in cover pages, individual project views, and bi-weekly/monthly reporting, and are available through Ask Karma.",
        ["Metrics & impact"],
      ],
      [
        "Simocracy integration v1",
        "Selection Committee members’ sims are up and running.",
        ["Sims & reviews"],
      ],
      [
        "Automated milestone review",
        "Sim reviewer assignment and assessment, notifications to the human reviewer, reminder triggers, and escalation flags for slow reviews.",
        ["Sims & reviews"],
      ],
      [
        "AI-native application process v1",
        "Application intake, AI-assisted application development and review, and a submission workflow.",
        ["Applications"],
      ],
      [
        "Admin queues live",
        "Applications, milestones and invoices each get a work item with trackable status and age.",
        ["Admin operations"],
      ],
      [
        "Navigation for the new funding framework",
        "UX and navigation improvements that support the three funding categories.",
        ["UX & comms"],
      ],
    ],
  },
  {
    dates: "Nov 1 – Dec 31, 2026",
    status: "Next",
    title: "Funding ops data & automation",
    items: [
      [
        "Keep iterating",
        "Continued iterations of Simocracy, application intake, admin queues, and metrics engagement (Ask Karma, reporting, cover pages).",
        ["Sims", "Apps", "Admin", "Metrics"],
      ],
      [
        "Slack & Telegram integration v1",
        "Relevant project discussions connect to the matching admin work items and project records.",
        ["Integrations", "Admin operations"],
      ],
      [
        "Automated project health monitoring",
        "Flags when a source in the metrics dashboard is down or below threshold.",
        ["Metrics & impact"],
      ],
      [
        "AI analytics dashboards for admins",
        "Admins can sort and view how AI assessments of milestones and applications line up with human reviewer sign-off.",
        ["Admin operations", "Sims & reviews"],
      ],
    ],
  },
  {
    dates: "Jan – Feb 2027",
    status: "Later",
    title: "Integrated program intelligence",
    items: [
      [
        "Keep iterating",
        "Continued iterations of Simocracy, application intake, admin queues, and metrics engagement.",
        ["Sims", "Apps", "Admin", "Metrics"],
      ],
      [
        "Project-level Hypercerts",
        "Project-specific hypercerts that capture and showcase verified outcomes and impact from funded work.",
        ["Metrics & impact", "Integrations"],
      ],
      [
        "Showcase roadmap impact",
        "Blogs and content highlighting what shipped through the filpgf.io roadmap and the impact it delivered.",
        ["UX & comms"],
      ],
    ],
  },
] as const;
---

<BaseLayout
  title="The filpgf.io roadmap"
  description="What we’re building into the Filecoin PGF portal, who is building it, and when each piece ships."
  breadcrumb="Roadmap"
>
  <article class="roadmap">
    <!-- Hero -->
    <section class="bg-surface pt-14 pb-10 sm:pt-20">
      <div class="container-page">
        <p class="eyebrow">Filecoin PGF roadmap</p>
        <h1 class="mt-4 text-4xl leading-[1.08] sm:text-5xl lg:text-6xl">
          The <span class="text-accent">filpgf.io</span> roadmap
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted italic">
          What we’re building into the Filecoin PGF portal, who is building it,
          and when each piece ships.
        </p>

        <p class="body-text mt-10 max-w-2xl">
          filpgf.io is becoming the place where the Filecoin Public Goods
          Funding (PGF) program shows its work: what’s funded, how those
          projects are doing, and how decisions get made. This page covers our
          objectives, the features that deliver them and the teams building
          them, how funding support comes together, and the roadmap for when
          each piece ships. For a shorter version, see the
          <a href="/blog/what-were-building-into-filpgf-io/"
            >companion blog post</a
          >.
        </p>

        <nav class="mt-10 max-w-2xl" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ol class="mt-3 border-t border-line">
            {
              [
                ["01", "What we’re building toward", "#building-toward", []],
                ["02", "Who we’re building with", "#building-with", []],
                [
                  "03",
                  "The features, up close",
                  "#features",
                  [
                    ["Impact and maintenance tracking", "#impact-tracking"],
                    ["AI-native applications and reviews", "#ai-native"],
                    ["Admin views and funding workflows", "#admin-views"],
                  ],
                ],
                [
                  "04",
                  "Funding support: faster decisions, fewer nudges",
                  "#funding-support",
                  [],
                ],
                ["05", "When each feature ships", "#ships", []],
                ["06", "What this adds up to", "#adds-up", []],
              ].map(([n, label, href, subs]) => (
                <li class="border-b border-line py-3">
                  <a
                    href={href as string}
                    class="flex items-baseline gap-4 hover:text-accent"
                  >
                    <span class="font-mono text-xs text-accent">{n}</span>
                    <span class="flex-1 font-semibold text-ink">{label}</span>
                    <span class="text-muted" aria-hidden="true">
                      ↓
                    </span>
                  </a>
                  {(subs as string[][]).length > 0 && (
                    <ul class="mt-1.5 ml-10 flex flex-wrap gap-x-4 gap-y-1">
                      {(subs as string[][]).map(([s, h]) => (
                        <li>
                          <a
                            href={h}
                            class="mono-meta toc-sub hover:text-accent"
                          >
                            {s}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>
      </div>
    </section>

    <!-- 01 What we're building toward -->
    <section id="building-toward" class="scroll-mt-16 py-14 sm:py-20">
      <div class="container-page">
        <h2 class="text-3xl sm:text-4xl">What we’re building toward</h2>
        <p class="body-text mt-5 max-w-2xl">
          The build is organized around three objectives: understand what
          funding produces, make applications and reviews faster and lighter,
          and give the people running the program one place to see and act on
          everything. Each one comes with a set of features, built together with
          our partners <a href="https://www.karmahq.org/">Karma</a>,
          <a href="https://www.oso.xyz/">OSO</a>, and
          <a href="https://www.simocracy.org/">Simocracy</a>.
        </p>

        <div class="mt-8 space-y-4">
          <div class="objective">
            <div>
              <p class="eyebrow">Objective 1</p>
              <h3 class="mt-2 text-xl">Measure impact and maintenance</h3>
            </div>
            <div>
              <p class="body-text">
                Funding only matters if what it produces lasts. OSO tracks
                impact and maintenance for every funded project across
                <a href="/kernel/">Kernel</a>, <a href="/rnd/">R&amp;D</a>, and
                <a href="/revenue-development/">Revenue Development</a>, and is
                being built out to flag stalled data sources before anyone has
                to go looking. Verified outcomes will also be captured as
                project-level hypercerts.
              </p>
              <ul class="chips">
                <li>Metrics on cover pages and reports</li>
                <li>Automated health monitoring</li>
                <li>Hypercerts on verified outcomes</li>
              </ul>
            </div>
          </div>

          <div class="objective">
            <div>
              <p class="eyebrow">Objective 2</p>
              <h3 class="mt-2 text-xl">
                Make applications and reviews AI-native
              </h3>
            </div>
            <div>
              <p class="body-text">
                Applications adapt to each project’s scope of work, and a
                Simocracy sim drafts the first review of every milestone. A
                person always makes the call, and every review is captured in
                filpgf.io.
              </p>
              <ul class="chips">
                <li>Adaptive applications</li>
                <li>Sim-assisted milestone review</li>
                <li>Human sign-off</li>
              </ul>
            </div>
          </div>

          <div class="objective">
            <div>
              <p class="eyebrow">Objective 3</p>
              <h3 class="mt-2 text-xl">
                Track every funded project, keep ops light
              </h3>
            </div>
            <div>
              <p class="body-text">
                Karma gives the program team one admin view of every
                application, milestone, and invoice, queued by priority and age.
                Feedback from Slack, Telegram, and Simocracy attaches to the
                item it belongs to, so there’s less chasing for everyone.
              </p>
              <ul class="chips">
                <li>Priority and age queues</li>
                <li>Slack and Telegram feedback</li>
                <li>SLA reporting</li>
              </ul>
            </div>
          </div>
        </div>

        <p class="mt-6 max-w-2xl text-sm leading-relaxed text-muted">
          Underneath all three: one source of truth for the program, so funded
          teams, reviewers, and the program team all work from the same
          information.
        </p>
      </div>
    </section>

    <!-- 02 Who we're building with -->
    <section
      id="building-with"
      class="scroll-mt-16 border-t border-line py-14 sm:py-20"
    >
      <div class="container-page">
        <p class="eyebrow">Who we’re building with</p>
        <h2 class="mt-3 text-2xl sm:text-3xl">One loop, three partners</h2>
        <p class="body-text mt-5 max-w-2xl">
          These pieces are being built to work together. Applications, reviews,
          and impact data all feed one system, so what we learn at each step
          informs the next. Every time the loop comes around, the next review
          starts with better data than the last one, and the same process helps
          us efficiently track and showcase the ecosystem’s needs and
          priorities, and keep applicants and stakeholders informed about them.
        </p>

        <figure class="panel mt-8">
          <div class="loop">
            <svg
              class="loop-ring"
              viewBox="0 0 600 560"
              aria-hidden="true"
              fill="none"
            >
              <circle
                cx="300"
                cy="290"
                r="210"
                stroke="var(--color-line)"
                stroke-width="7"></circle>
              <g fill="var(--color-ink)">
                <path
                  d="M-10 -8 L10 0 L-10 8 Z"
                  transform="translate(449 141) rotate(45)"></path>
                <path
                  d="M-10 -8 L10 0 L-10 8 Z"
                  transform="translate(300 500) rotate(180)"></path>
                <path
                  d="M-10 -8 L10 0 L-10 8 Z"
                  transform="translate(151 141) rotate(-45)"></path>
              </g>
            </svg>

            <div class="loop-center">
              <p class="text-xl font-semibold text-ink">filpgf.io</p>
              <p class="eyebrow mt-1">One shared record</p>
            </div>

            <p class="loop-label loop-label-syncs">
              <strong>Syncs</strong><br />applications &amp; milestones
            </p>
            <p class="loop-label loop-label-informs">
              <strong>Informs</strong><br />funded projects to track
            </p>
            <p class="loop-label loop-label-feeds">
              <strong>Feeds back</strong><br />impact &amp; maintenance metrics
            </p>

            {
              PARTNERS.map((p) => (
                <a href={p.link.href} class={`partner partner-${p.pos}`}>
                  <p class="flex items-center gap-2">
                    <span class="num">{p.n}</span>
                    <span class="eyebrow">{p.role}</span>
                  </p>
                  <p class="mt-1.5 text-lg font-semibold text-ink">{p.name}</p>
                  <p class="mt-1.5 text-sm leading-relaxed">{p.body}</p>
                  <p class="mt-2.5 font-mono text-xs text-accent">
                    {p.link.label} →
                  </p>
                </a>
              ))
            }
          </div>
        </figure>
        <p class="caption">
          How the pieces work together inside filpgf.io. Select a partner to
          jump to its feature area.
        </p>
      </div>
    </section>

    <!-- 03 The features, up close -->
    <section id="features" class="scroll-mt-16 pb-14 sm:pb-20">
      <div class="container-page border-t-2 border-ink pt-14 sm:pt-20">
        <p class="eyebrow">Feature spotlights</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">The features, up close</h2>
        <p class="body-text mt-5 max-w-2xl">
          Each objective comes down to a set of features. Here is what each one
          does, what it looks like, and who is building it: OSO on impact and
          maintenance data, Simocracy on AI-native applications and milestone
          review, and Karma on the platform and admin views that tie everything
          together.
        </p>

        <!-- Feature area 1 -->
        <div id="impact-tracking" class="feature scroll-mt-16">
          <div class="feature-head">
            <p class="eyebrow">Feature area 1</p>
            <h3 class="mt-3 text-3xl leading-tight sm:text-4xl">
              Impact and maintenance tracking
            </h3>
            <p class="mono-meta mt-4">Kernel · R&amp;D · Revenue Development</p>
            <p class="pill mt-3">
              Built with <a href="https://www.oso.xyz/">OSO</a>
            </p>
          </div>
          <div>
            <p class="body-text">
              Funding a project is one decision. Knowing whether it keeps
              delivering takes ongoing measurement. In filpgf.io, every funded
              project gets two things kept current:
              <strong>impact</strong> (what the work is producing) and
              <strong>maintenance</strong> (whether it is still actively built and
              cared for). The approach runs across all three funding categories, with
              one addition for RevDev: a revenue-linked metric such as paid usage,
              onchain revenue, or paying customers.
            </p>
            <aside class="team">
              <p class="mono-meta uppercase">The team</p>
              <p class="mt-1.5">
                <a href="https://www.oso.xyz/">Open Source Observer (OSO)</a> is an
                AI-native data platform that pulls scattered signals into one semantic
                layer, so people and agents work from the same source of truth. Its
                core measurements, such as monthly active developers, builder retention,
                and new developer acquisition, are how open source ecosystems tell
                a thriving project from one that has gone quiet.
              </p>
            </aside>
          </div>
        </div>

        <figure class="panel mt-8">
          <p class="panel-title">What gets tracked, by funding category</p>
          <table class="data-table mt-4">
            <thead>
              <tr>
                <th></th>
                <th class="text-center">Kernel</th>
                <th class="text-center">R&amp;D</th>
                <th class="text-center">RevDev</th>
              </tr>
            </thead>
            <tbody>
              {
                TRACKED.map(([item, k, r, v]) => (
                  <tr>
                    <td>{item}</td>
                    {[k, r, v].map((on) => (
                      <td class="text-center">
                        {on ? (
                          <span class="dot" aria-label="Included" />
                        ) : (
                          <span class="text-muted" aria-label="Not included">
                            —
                          </span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </figure>
        <p class="caption">
          Planned coverage by funding category. Goals: 90% of approved Kernel,
          RevDev and R&amp;D projects carry at least one published health
          metric, and 100% of RevDev projects carry a revenue-linked metric.
          These are program goals, not yet results.
        </p>

        <figure class="panel mt-8">
          <p class="panel-title">
            Kernel health monitoring, funded teams this batch
          </p>
          <div class="mt-5 grid gap-6 sm:grid-cols-3">
            <div>
              <p class="mono-meta uppercase">Reading coverage · 30d</p>
              <p class="stat">100%</p>
              <p class="text-sm text-muted">
                922 of 922 expected reading periods carry a value
              </p>
            </div>
            <div>
              <p class="mono-meta uppercase">Metrics collected</p>
              <p class="stat">45</p>
              <p class="text-sm text-muted">
                each on its own cadence, from a public source
              </p>
            </div>
            <div>
              <p class="mono-meta uppercase">Active funded projects</p>
              <p class="stat">14</p>
              <p class="text-sm text-muted">
                Projects with a metric against them
              </p>
            </div>
          </div>
          <div class="mt-6 overflow-x-auto">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Team</th>
                  <th>Kernel functions by tier</th>
                  <th>Metrics</th>
                  <th>Functions</th>
                  <th>Coverage · 30d</th>
                </tr>
              </thead>
              <tbody>
                {
                  TEAMS.map(([team, tier, metrics, fns]) => (
                    <tr>
                      <td class="font-medium text-ink">{team}</td>
                      <td class="mono-meta">{tier}</td>
                      <td>{metrics}</td>
                      <td>{fns}</td>
                      <td class="font-mono text-xs text-ok">100.0%</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </figure>
        <p class="caption">
          Snapshot from the
          <a href="/kernel/">live Kernel monitoring view on filpgf.io</a>, 25
          September 2026. Every metric is fetched nightly from a public source
          by a pipeline the team does not control. Projects, the Kernel
          functions they steward, and their metric definitions are registered in
          the public
          <a href="https://github.com/filecoin-project/pgf-monitor"
            >pgf-monitor repository</a
          >.
        </p>

        <p class="body-text mt-8 max-w-2xl">
          Automation keeps the numbers honest. Automated project health
          monitoring will flag when a source in the metrics dashboard goes down
          or drops below a threshold, so the team notices a stale number before
          the community does. Verified metrics then flow into cover pages,
          project views, bi-weekly and monthly reports, and the Ask Karma
          assistant. For Kernel, this already runs in public: the projects
          stewarding each Kernel function and their metric definitions are
          registered in the
          <a href="https://github.com/filecoin-project/pgf-monitor"
            >pgf-monitor repository on GitHub</a
          >, which powers the
          <a href="/kernel/">Kernel health monitoring on filpgf.io</a>.
        </p>

        <!-- Feature area 2 -->
        <div
          id="ai-native"
          class="feature scroll-mt-16 mt-16 border-t border-line pt-12"
        >
          <div class="feature-head">
            <p class="eyebrow">Feature area 2</p>
            <h3 class="mt-3 text-3xl leading-tight sm:text-4xl">
              AI-native applications and reviews
            </h3>
            <p class="mono-meta mt-4">Application intake · Milestone review</p>
            <p class="pill mt-3">
              Built with <a href="https://www.simocracy.org/">Simocracy</a>
            </p>
          </div>
          <div>
            <p class="body-text">
              Two processes go AI-native: how projects apply, and how they are
              reviewed. For both project applications and project milestones, a
              sim does the first assessment, and a person reviews it and decides
              if it’s cleared for approval. The point is to make the ops side of
              reviews lightweight, for reviewers and for the teams receiving
              funding. Simocracy is
              <a
                href="/blog/from-funding-history-to-digital-twins-launching-simocracy-for-propgf/"
                >now live in our review process</a
              >, and iterations are ongoing.
            </p>
            <aside class="team">
              <p class="mono-meta uppercase">The team</p>
              <p class="mt-1.5">
                <a href="https://www.simocracy.org/">Simocracy</a> is a platform for
                AI-powered governance participation. Someone completes a five-minute
                interview and mints a <strong>sim</strong>: a digital twin with
                an avatar, a constitution that captures their values, and a
                speaking style. Simocracy’s own line is “sims as the engine,
                humans as the steering wheel,” and it has already been used in
                funding experiments such as Funding the Commons.
              </p>
            </aside>
          </div>
        </div>

        <div class="mt-10 grid gap-8 border-t border-line pt-8 sm:grid-cols-2">
          <div>
            <h4 class="text-lg font-semibold text-ink">
              AI-native application process
            </h4>
            <p class="mt-2 text-[0.95rem] leading-relaxed">
              Applications will be pre-populated using existing project
              information, so Kernel teams do not need to resubmit information
              already on file. Teams can review the pre-populated application,
              make any necessary updates, and submit.
            </p>
          </div>
          <div>
