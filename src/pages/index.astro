---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatGrid from "../components/StatGrid.astro";
import ObjectiveCard from "../components/ObjectiveCard.astro";
import ReportCard from "../components/ReportCard.astro";
import ArrowLink from "../components/ArrowLink.astro";
import Button from "../components/Button.astro";
import PostMeta from "../components/PostMeta.astro";
import {
  buildHeadlineStats,
  buildObjectiveCards,
  HOME_COPY,
  REPORT_CADENCES,
} from "../data/landing";
import { fetchCommunityMetrics, fetchLiveCounts } from "../lib/karma";
import { SITE, EXTERNAL, ASK_KARMA } from "../data/site";

/*
 * On demand rather than prerendered so the headline stats track the API without
 * a deploy; ISR keeps that to one pair of requests per expiration window.
 */
export const prerender = false;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const [featured, ...rest] = posts;

// Read once per render; each stat falls back to its committed value on its own,
// so a slow or unreachable API costs freshness rather than the page. Since the
// render is now cached, a fallback render can stay live for an expiration
// window — where a build-time failure could only ever leave the last good HTML
// in place.
const [liveCounts, communityMetrics] = await Promise.all([
  fetchLiveCounts(),
  fetchCommunityMetrics(),
]);
const headlineStats = buildHeadlineStats(liveCounts, communityMetrics);
const objectiveCards = buildObjectiveCards(communityMetrics);

/*
 * Who publishes the site, for agents and search. Only what the site itself
 * states: no contact point or address yet, since it publishes neither.
 */
const home = new URL("/", Astro.site).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${home}#organization`,
      name: SITE.title,
      alternateName: SITE.name,
      url: home,
      description: SITE.description,
      logo: new URL("/apple-touch-icon.png", Astro.site).href,
    },
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: SITE.title,
      url: home,
      description: SITE.description,
      inLanguage: "en",
      publisher: { "@id": `${home}#organization` },
    },
  ],
};
---

<BaseLayout title={SITE.title} cta={ASK_KARMA}>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(structuredData)}
  />
  <!-- Hero -->
  <section class="bg-surface pt-16 pb-14 sm:pt-24 sm:pb-16">
    <div class="container-page">
      <h1 class="max-w-3xl text-5xl leading-[1.05] sm:text-6xl lg:text-7xl">
        {HOME_COPY.heading}
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed">
        {SITE.description}
      </p>

      <div class="mt-12">
        <StatGrid stats={headlineStats} />
      </div>
    </div>
  </section>

  <!-- Objectives -->
  <Section id="objectives">
    <SectionHeader {...HOME_COPY.objectives} />
    <div class="mt-10 space-y-5">
      {objectiveCards.map((card) => <ObjectiveCard {...card} />)}
    </div>
  </Section>

  <!-- Reporting -->
  <Section id="reporting" tint>
    <SectionHeader {...HOME_COPY.reporting} />
    <div class="mt-10 space-y-5">
      {REPORT_CADENCES.map((report) => <ReportCard report={report} />)}
    </div>
    <p class="mt-8 text-sm text-muted">
      Looking for a specific initiative? <ArrowLink
        href={EXTERNAL.explorer}
        label="Browse every project in the explorer"
      />
    </p>
  </Section>

  <!-- Blog -->
  <Section id="blog">
    <SectionHeader {...HOME_COPY.blog} />

    {
      featured && (
        <article class="mt-10 rounded-lg border border-line bg-surface p-6 sm:p-8">
          <PostMeta date={featured.data.date} author={featured.data.author} />
          <h3 class="mt-3 text-xl sm:text-2xl">
            <a href={`/blog/${featured.id}/`} class="hover:text-accent">
              {featured.data.title}
            </a>
          </h3>
          <p class="mt-3 max-w-3xl text-[0.95rem] leading-relaxed">
            {featured.data.description}
          </p>
          <p class="mt-5">
            <ArrowLink href={`/blog/${featured.id}/`} label="Read the post" />
          </p>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <ul class="mt-8 border-t border-line">
          {rest.map((post) => (
            <li class="border-b border-line py-4">
              <a href={`/blog/${post.id}/`} class="group block">
                <PostMeta date={post.data.date} />
                <p class="mt-1 text-base font-medium text-ink group-hover:text-accent">
                  {post.data.title}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-6">
      <ArrowLink href="/blog/" label="All posts" />
    </p>
  </Section>

  <!-- Funding CTA -->
  <Section id="funding" tint>
    <SectionHeader {...HOME_COPY.funding} />
    <div class="mt-8">
      <Button href="#objectives">Compare the three programs</Button>
    </div>
  </Section>
</BaseLayout>
