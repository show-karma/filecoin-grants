---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatGrid from "../components/StatGrid.astro";
import ObjectiveCard from "../components/ObjectiveCard.astro";
import ReportCard from "../components/ReportCard.astro";
import ArrowLink from "../components/ArrowLink.astro";
import Button from "../components/Button.astro";
import PostMeta from "../components/PostMeta.astro";
import {
  LAST_UPDATED,
  HEADLINE_STATS,
  OBJECTIVES,
  REPORT_CADENCES,
} from "../data/landing";
import { SITE, EXTERNAL, reportUrl } from "../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const [featured, ...rest] = posts;
---

<BaseLayout
  title={SITE.title}
  cta={{ label: "Latest report", href: reportUrl("biweeklyProgress") }}
>
  <!-- Hero -->
  <section class="bg-white pt-16 pb-14 sm:pt-24 sm:pb-16">
    <div class="container-page">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1"
      >
        <span class="sync-dot" aria-hidden="true"></span>
        <span class="font-mono text-[0.6875rem] tracking-[0.14em] uppercase"
          >Updated {LAST_UPDATED}</span
        >
      </p>

      <h1
        class="mt-8 max-w-3xl text-5xl leading-[1.05] sm:text-6xl lg:text-7xl"
      >
        The work behind the network, in the open.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-relaxed">
        {SITE.description}
      </p>

      <div class="mt-12">
        <StatGrid stats={HEADLINE_STATS} />
      </div>
    </div>
  </section>

  <!-- Objectives -->
  <Section id="objectives">
    <SectionHeader
      eyebrow="Objectives"
      title="Three objectives everything ladders up to"
      intro="Three programs fund this work — Kernel for what the network can't run without, Revenue Development for growth, R&D for early work that graduates into the other two. Each objective maps to one, and each program sets its own terms, timeline, and measure of success."
    />
    <div class="mt-10 space-y-5">
      {OBJECTIVES.map((objective) => <ObjectiveCard objective={objective} />)}
    </div>
  </Section>

  <!-- Reporting -->
  <Section id="reporting" tint>
    <SectionHeader
      eyebrow="Tracking"
      title="How we report"
      intro="Progress is published on a fixed cadence, so anyone can see what's moving. Reports cover delivery against milestones, health metrics for each funded function, and the network-level impact the work is meant to produce."
    />
    <div class="mt-10 space-y-5">
      {REPORT_CADENCES.map((report) => <ReportCard report={report} />)}
    </div>
    <p class="mt-8 text-sm text-muted">
      Looking for a specific initiative? <ArrowLink href={EXTERNAL.explorer}
        >Browse every funded project in the explorer</ArrowLink
      >
    </p>
  </Section>

  <!-- Blog -->
  <Section id="blog">
    <SectionHeader
      eyebrow="From the blog"
      title="Follow along"
      intro="Track program updates and spotlighted projects. New rounds, selection committees, and open calls get posted here first."
    />

    {
      featured && (
        <article class="mt-10 rounded-lg border border-line bg-white p-6 sm:p-8">
          <PostMeta date={featured.data.date} author={featured.data.author} />
          <h3 class="mt-3 text-xl sm:text-2xl">
            <a href={`/blog/${featured.id}/`} class="hover:text-accent">
              {featured.data.title}
            </a>
          </h3>
          <p class="mt-3 max-w-3xl text-[0.95rem] leading-relaxed">
            {featured.data.description}
          </p>
          <p class="mt-5">
            <ArrowLink href={`/blog/${featured.id}/`}>Read the post</ArrowLink>
          </p>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <ul class="mt-8 border-t border-line">
          {rest.map((post) => (
            <li class="border-b border-line py-4">
              <a href={`/blog/${post.id}/`} class="group block">
                <PostMeta date={post.data.date} />
                <p class="mt-1 text-base font-medium text-ink group-hover:text-accent">
                  {post.data.title}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-6">
      <ArrowLink href="/blog/">All posts</ArrowLink>
    </p>
  </Section>

  <!-- Funding CTA -->
  <Section id="funding" tint>
    <SectionHeader
      eyebrow="Get funded"
      title="Where your work fits"
      intro="If your work belongs on the ledger, start by identifying which objective it serves — the application, the evaluation, and the payout schedule all follow from that."
    />
    <div class="mt-8">
      <Button href="#objectives">Compare the three programs</Button>
    </div>
  </Section>
</BaseLayout>
