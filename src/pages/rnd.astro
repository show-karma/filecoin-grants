---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CriteriaList from "../components/CriteriaList.astro";
import PageHero from "../components/PageHero.astro";
import FocusAreaCard from "../components/rnd/FocusAreaCard.astro";
import {
  RND_EVALUATION,
  RND_FOCUS_AREAS,
  RND_LOOKING_FOR,
  RND_NOT_IN_SCOPE,
  RND_OPEN_RFPS,
} from "../data/programs";
---

<BaseLayout
  title="R&D"
  description="R&D backs work that closes gaps in the network before they become problems. RFPs are published as gaps are identified and applications are reviewed as they arrive, with funding released in stages as the work proves out."
  cta={{ label: "Get notified", href: "/blog/" }}
  breadcrumb="R&D"
  accent="rd"
>
  <PageHero
    eyebrow="R&D · Program overview"
    title="Funding what the network needs next."
    intro="R&D backs work that closes gaps in the network before they become problems. RFPs are published as gaps are identified and applications are reviewed as they arrive, with funding released in stages as the work proves out. The strongest proposals name the gap they close and say why it matters now."
  />

  <!-- Objective -->
  <Section id="objective">
    <SectionHeader eyebrow="Objective" title="Fund what's missing" />

    {/* Stacked, as in the design — the criteria card sits below the prose. */}
    <div class="mt-8 max-w-3xl space-y-5 text-[0.95rem] leading-relaxed">
      <p>
        R&D funds work aimed at a specific gap in the network: something
        missing, thinly covered, or dependent on a single implementation. The
        strongest proposals name that gap plainly and explain why closing it
        matters now rather than later.
      </p>
      <p>
        Most of this work sits alongside the pods, supporting what they're
        building without duplicating what they already own.
      </p>
      <p>
        There are several ways R&D work pays off. It can produce findings the
        ecosystem uses whether or not the work continues, add a second
        implementation where the network currently depends on one, or take up an
        available route into ongoing Kernel or Revenue Development funding.
      </p>
    </div>

    <div
      id="scope"
      class="mt-10 scroll-mt-24 space-y-6 rounded-lg border border-line bg-surface p-6 sm:p-7"
    >
      <CriteriaList
        label="We're looking for"
        items={RND_LOOKING_FOR}
        tone="in"
      />
      <div class="border-t border-line-soft pt-6">
        <CriteriaList
          label="Not in scope"
          items={RND_NOT_IN_SCOPE}
          tone="out"
        />
      </div>
    </div>
  </Section>

  <!-- Open RFPs -->
  <Section id="rfps" tint>
    <SectionHeader
      eyebrow="Open RFPs"
      title="What we're asking for"
      intro="R&D is request-driven — the usual way in is a response to a published RFP rather than an unsolicited proposal."
    />

    <div
      class="mt-8 max-w-2xl rounded-lg border border-dashed p-6"
      style="border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-surface)); background: color-mix(in srgb, var(--color-accent) 5%, var(--color-surface))"
    >
      <p class="eyebrow">{RND_OPEN_RFPS.eyebrow}</p>
      <h3 class="mt-2.5 text-xl">{RND_OPEN_RFPS.title}</h3>
      <p class="mt-3 text-[0.95rem] leading-relaxed">
        {RND_OPEN_RFPS.description}
      </p>
    </div>

    <div class="mt-10 space-y-6">
      {
        RND_FOCUS_AREAS.map((area, index) => (
          <FocusAreaCard area={area} index={index} />
        ))
      }
    </div>

    <div
      id="evaluation"
      class="mt-6 scroll-mt-24 rounded-lg border border-line bg-surface p-6 sm:p-7"
    >
      <p class="eyebrow">Evaluation</p>
      <h3 class="mt-2.5 text-xl">How proposals are reviewed</h3>

      <dl class="mt-5 space-y-2.5 border-t border-line-soft pt-5">
        {
          RND_EVALUATION.map((row) => (
            <div class="flex flex-col gap-1 sm:flex-row sm:gap-5">
              <dt class="mono-meta w-24 shrink-0 uppercase">{row.label}</dt>
              <dd class="text-[0.95rem] leading-relaxed">{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>
</BaseLayout>
