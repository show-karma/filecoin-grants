---
import CriteriaList from "../CriteriaList.astro";
import type { FocusArea } from "../../data/programs";

type Props = { area: FocusArea; index: number };
const { area, index } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<article class="rounded-lg border border-line bg-surface p-6 sm:p-7">
  <p class="eyebrow">Focus / {number}</p>
  <h3 class="mt-2.5 text-xl">{area.title}</h3>
  {area.note && <p class="mt-2 text-sm leading-relaxed text-body">{area.note}</p>}

  <div class="mt-6 grid gap-6 border-t border-line-soft pt-6 md:grid-cols-2">
    <CriteriaList label="In scope" items={area.inScope} tone="in" />
    <CriteriaList label="Not in scope" items={area.notInScope} tone="out" />
  </div>
</article>
