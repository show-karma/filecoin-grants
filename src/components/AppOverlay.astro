---
/**
 * Sign-in, run over the site instead of on a page of its own.
 *
 * The dialog is the app's, inside an iframe on the app's origin — that is the
 * point: the session it creates belongs to the app, where a login performed on
 * this origin would be stranded. The app serves that route as a bare surface
 * (`embed=login`), painting nothing but the dialog, so what shows here is the
 * sign-in card and this backdrop — the same shape the app itself presents,
 * with no second panel wrapped around it.
 *
 * Any element with `data-app-overlay="<path>"` opens it. Without JavaScript
 * the trigger is still a link to the same URL.
 */
import { APP_PREVIEW_ORIGIN, EXTERNAL } from "../data/site";

const isPreviewBuild = Boolean(
  process.env.VERCEL_ENV && process.env.VERCEL_ENV !== "production",
);
const appOrigin =
  import.meta.env.PUBLIC_APP_ORIGIN ??
  (isPreviewBuild ? APP_PREVIEW_ORIGIN : EXTERNAL.app);
---

<div
  data-app-overlay-root
  data-app-origin={appOrigin}
  class="fixed inset-0 z-[100] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Sign in"
>
  <div data-app-overlay-backdrop class="absolute inset-0 bg-deep/70"></div>

  <div
    data-app-overlay-frame
    class="relative h-[min(640px,88vh)] w-[min(420px,100%)]"
  >
    <p
      data-app-overlay-status
      class="absolute inset-0 flex items-center justify-center text-sm text-white/80"
    >
      Loading&hellip;
    </p>
  </div>

  <button
    type="button"
    data-app-overlay-close
    aria-label="Close"
    class="absolute right-4 top-4 flex h-9 w-9 cursor-pointer items-center justify-center rounded-md text-white/70 transition-colors hover:text-white"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>
</div>

<script>
  const root = document.querySelector<HTMLElement>("[data-app-overlay-root]");
  const triggers = Array.from(
    document.querySelectorAll<HTMLElement>("[data-app-overlay]"),
  );

  if (root && triggers.length) {
    const origin = root.dataset.appOrigin ?? "";
    const frameHost = root.querySelector<HTMLElement>("[data-app-overlay-frame]")!;
    const closeButton = root.querySelector<HTMLButtonElement>("[data-app-overlay-close]")!;
    const backdrop = root.querySelector<HTMLElement>("[data-app-overlay-backdrop]")!;
    const status = root.querySelector<HTMLElement>("[data-app-overlay-status]")!;

    let lastFocused: HTMLElement | null = null;
    let frame: HTMLIFrameElement | null = null;

    const close = () => {
      root.classList.remove("flex");
      root.classList.add("hidden");
      document.documentElement.style.removeProperty("overflow");
      // Drop the frame so a reopen starts clean rather than resuming a
      // half-finished sign-in.
      frame?.remove();
      frame = null;
      lastFocused?.focus();
    };

    const open = (path: string, label: string) => {
      lastFocused = document.activeElement as HTMLElement | null;
      status.hidden = false;

      frame?.remove();
      frame = document.createElement("iframe");
      frame.src = `${origin}${path}`;
      frame.title = label;
      // Transparency comes from the framed document's own background, which
      // the app paints as transparent on this route — so this backdrop shows
      // through and the sign-in card is the only thing drawn.
      frame.className = "relative h-full w-full border-0 bg-transparent";
      frame.addEventListener("load", () => {
        status.hidden = true;
      });

      frameHost.appendChild(frame);

      root.classList.remove("hidden");
      root.classList.add("flex");
      document.documentElement.style.setProperty("overflow", "hidden");
      closeButton.focus();
    };

    for (const trigger of triggers) {
      trigger.addEventListener("click", (event) => {
        const path = trigger.dataset.appOverlay;
        if (!path) return;
        const mouse = event as MouseEvent;
        if (mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.button > 0) return;
        event.preventDefault();
        open(path, trigger.dataset.appOverlayLabel ?? "Sign in");
      });
    }

    closeButton.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && root.classList.contains("flex")) close();
    });
  }
</script>
