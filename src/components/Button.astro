---
type Props = {
  href: string;
  variant?: "solid" | "inverse";
  class?: string;
};

const { href, variant = "solid", class: className = "" } = Astro.props;
const isExternal = href.startsWith("http");

const variants = {
  solid: "bg-deep text-white hover:opacity-90",
  inverse: "bg-white text-ink hover:bg-tint",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-md px-5 py-2.5 text-sm font-medium transition-opacity",
    variants[variant],
    className,
  ]}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <slot />
</a>
