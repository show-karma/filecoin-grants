---
type Props = {
  href: string;
  variant?: "solid" | "inverse";
  class?: string;
};

const { href, variant = "solid", class: className = "" } = Astro.props;
const isExternal = href.startsWith("http");

const variants = {
  solid: "bg-deep text-white hover:opacity-90",
  // Only ever sits on a --color-deep panel, which is dark in both themes,
  // so this pair stays constant rather than following the theme.
  inverse: "bg-deep-fg text-deep hover:opacity-90",
};
---

<a
  href={href}
  class:list={[
    // py-3 keeps the button at the 44px minimum touch target.
    "inline-flex items-center justify-center rounded-md px-5 py-3 text-sm font-medium transition-opacity",
    variants[variant],
    className,
  ]}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <slot />
</a>
