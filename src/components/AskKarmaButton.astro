---
/**
 * The app's assistant trigger: a brand-tinted pill carrying the Karma mark,
 * icon-only until there is room for the label.
 *
 * `data-karma-chat-open` is what opens the widget in place; the `href` is the
 * fallback the header script uses if the bundle never loads.
 */
import { ASK_KARMA } from "../data/site";

type Props = { compact?: boolean; class?: string };
const { compact = false, class: className = "" } = Astro.props;
---

<a
  href={ASK_KARMA.href}
  data-karma-chat-open
  aria-label={ASK_KARMA.label}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    "inline-flex h-9 shrink-0 items-center justify-center rounded-full border border-[rgba(76,111,255,0.3)] bg-[rgba(76,111,255,0.05)] font-medium leading-normal text-[var(--nav-accent)] transition-colors hover:bg-[rgba(76,111,255,0.1)]",
    compact ? "w-9" : "w-9 xl:w-auto xl:gap-1.5 xl:px-3 xl:text-sm",
    className,
  ]}
>
  {/* The mark is drawn in `currentColor`, so it follows the pill's text. */}
  <span aria-hidden="true" class="flex items-center justify-center">
    <svg
      viewBox="0 0 31 32"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      class:list={[compact ? "h-4 w-4" : "h-4 w-4 xl:h-3.5 xl:w-3.5"]}
    >
      <path
        d="M21.8357 15.9945C24.2444 14.038 26.1986 11.8826 27.6756 9.56131C29.6298 6.47738 30.6183 3.26079 30.6183 0H27.2098C27.2098 2.6418 26.3917 5.27254 24.767 7.82591C23.3809 10.0035 21.404 12.1036 19.018 13.9496C18.1204 13.3637 17.2001 12.8111 16.2571 12.3026C21.3244 8.79862 24.0967 4.44352 24.0967 0H20.6882C20.6882 3.4266 18.1659 7.04111 13.7803 9.93713C13.4281 10.1693 13.0531 10.4014 12.6896 10.6225C11.9624 10.324 11.2353 10.0477 10.4968 9.80449V0.0110535H7.08825V8.83178C5.95208 8.56649 4.80455 8.36753 3.67974 8.22383V0.0110535H0.27124V8.00276V11.3188C2.91851 11.3188 5.72485 11.7831 8.50846 12.6342C5.71349 13.7174 2.81626 14.3254 0.27124 14.3254V17.6415C2.81626 17.6415 5.70212 18.2604 8.50846 19.3326C5.73621 20.1838 2.92987 20.648 0.27124 20.648V23.9641V31.9889H3.67974V23.7762C4.80455 23.6435 5.95208 23.4335 7.08825 23.1682V31.9889H10.4968V22.1955C11.2353 21.9413 11.9624 21.676 12.6896 21.3775C13.0645 21.5986 13.4281 21.8197 13.7803 22.0629C18.1659 24.9478 20.6882 28.5734 20.6882 32H24.0967C24.0967 27.5565 21.3131 23.2014 16.2571 19.6974C17.2001 19.1889 18.1204 18.6363 19.018 18.0504C21.404 19.8853 23.3923 21.9965 24.767 24.1741C26.3804 26.7275 27.2098 29.3582 27.2098 32H30.6183C30.6183 28.7392 29.6298 25.5226 27.6756 22.4387C26.21 20.1064 24.2444 17.9509 21.8357 15.9945ZM9.01973 15.9945C10.3377 15.5302 11.6329 14.9665 12.8827 14.3254C13.9507 14.8228 14.996 15.3865 16.0185 15.9945C15.0073 16.6024 13.9621 17.1661 12.8827 17.6636C11.6329 17.0225 10.3263 16.4698 9.01973 15.9945Z"
        fill="currentColor"></path>
    </svg>
  </span>
  {
    /* The label is hidden below `xl`, where the row has no room for it; the
      `aria-label` above carries the name at every width. */
  }
  {!compact && <span class="hidden xl:inline">{ASK_KARMA.label}</span>}
</a>
