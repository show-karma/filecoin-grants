---
import Wordmark from "./Wordmark.astro";
import type { NavItem } from "../data/site";

type Props = {
  nav: NavItem[];
  cta?: { label: string; href: string };
  breadcrumb?: string;
};

const { nav, cta, breadcrumb } = Astro.props;
---

<header
  class="sticky top-0 z-40 border-b border-line bg-white/90 backdrop-blur-sm"
>
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <Wordmark breadcrumb={breadcrumb} />

    <!-- Desktop nav -->
    <nav aria-label="Main" class="hidden items-center gap-7 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-body transition-colors hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
      {
        cta && (
          <a
            href={cta.href}
            class="rounded-md bg-deep px-4 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90"
          >
            {cta.label}
          </a>
        )
      }
    </nav>

    <!-- Mobile nav: CSS-only disclosure, no client JS -->
    <details class="group relative md:hidden">
      <summary
        class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-line text-ink [&::-webkit-details-marker]:hidden"
        aria-label="Toggle menu"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden"></path>
          <path d="M6 6l12 12M18 6L6 18" class="hidden group-open:block"></path>
        </svg>
      </summary>
      <nav
        aria-label="Main"
        class="absolute right-0 mt-2 w-56 rounded-lg border border-line bg-white p-2 shadow-lg"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="block rounded-md px-3 py-2 text-sm text-body hover:bg-tint hover:text-ink"
            >
              {item.label}
            </a>
          ))
        }
        {
          cta && (
            <a
              href={cta.href}
              class="mt-1 block rounded-md bg-deep px-3 py-2 text-center text-sm font-medium text-white"
            >
              {cta.label}
            </a>
          )
        }
      </nav>
    </details>
  </div>
</header>
