---
import ArrowLink from "./ArrowLink.astro";
import type { Stat } from "../data/landing";

type Props = { stats: Stat[] };
const { stats } = Astro.props;

/**
 * Cells are padded on both sides so a figure never sits flush against a
 * divider, except where the cell leads a row — there the padding is dropped so
 * the figure stays optically aligned with the hero text above it.
 *
 * Which cell leads a row depends on the column count (1 at base, 2 at sm, 4 at
 * lg), so the classes are emitted per index rather than with `odd:`/`first:`
 * variants. Those pseudo-class variants carry higher specificity than a plain
 * breakpoint utility, so `sm:odd:pl-0` silently beat `lg:pl-6` at desktop and
 * left the third cell flush against its divider.
 */
const cellClass = (i: number) =>
  [
    "flex flex-col bg-surface pt-5 pb-2 sm:pt-6 sm:pr-6",
    i % 2 === 0 ? "sm:pl-0" : "sm:pl-6",
    i % 4 === 0 ? "lg:pl-0" : "lg:pl-6",
  ].join(" ");
---

{
  /*
  A <dl> group may contain only <dt> and <dd>, and the <dt> must come first —
  so the label leads in the DOM and `order` puts the figure above it visually.
*/
}
<dl
  class="grid grid-cols-1 gap-px border-t border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
>
  {
    stats.map((stat, i) => (
      <div class={cellClass(i)}>
        <dt class="order-2 mt-1 text-sm leading-snug text-body">
          {stat.label}
        </dt>
        <dd class="order-1 font-mono text-2xl font-medium tracking-tight text-ink">
          {stat.value}
        </dd>
        <dd class="order-3 mt-3">
          <ArrowLink href={stat.href} label={stat.linkText} />
        </dd>
      </div>
    ))
  }
</dl>
