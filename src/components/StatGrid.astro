---
import ArrowLink from "./ArrowLink.astro";
import type { Stat } from "../data/landing";

type Props = { stats: Stat[] };
const { stats } = Astro.props;
---

<dl
  class="grid grid-cols-1 gap-px border-t border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
>
  {
    stats.map((stat) => (
      <div class="flex flex-col bg-white pt-5 pr-4 pb-1 sm:pt-6">
        <dt class="sr-only">{stat.label}</dt>
        <dd class="font-mono text-2xl font-medium tracking-tight text-ink">
          {stat.value}
        </dd>
        <p class="mt-1 text-sm leading-snug text-body">{stat.label}</p>
        <p class="mt-3">
          <ArrowLink href={stat.href}>{stat.linkText}</ArrowLink>
        </p>
      </div>
    ))
  }
</dl>
