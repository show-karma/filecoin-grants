---
import type { PodEntry } from "../../data/pods-api";
import { formatDay, formatMonth } from "../../data/pods-api";
import { podCopy } from "../../data/pods-copy";
import PodMetricCard from "./PodMetricCard.astro";

type Props = { pod: PodEntry };
const { pod } = Astro.props;

const copy = podCopy(pod.podSlug);

/*
 * The three KPIs OSO pins for this pod, in its order. A pod's reviews carry
 * more series than that; the ones here are the ones its agreement is read
 * against, and the rest would crowd the card out.
 */
const kpis = (copy?.kpis ?? [])
  .map((kpi) => ({
    kpi,
    metric: pod.metrics.find((m) => m.metricKey === kpi.metricKey),
  }))
  .filter(
    (
      entry,
    ): entry is {
      kpi: (typeof entry)["kpi"];
      metric: NonNullable<(typeof entry)["metric"]>;
    } => Boolean(entry.metric),
  );

const shipped = pod.commitments.filter((c) => c.isDelivered);
const open = pod.commitments.filter((c) => !c.isDelivered);

const firstReport = formatMonth(pod.firstReportAt);
const latestReport = formatDay(pod.latestReportAt);

const strapline = [
  `Run by ${pod.team}`,
  copy?.strapline,
  "reporting biweekly",
  firstReport && `first report ${firstReport}`,
]
  .filter(Boolean)
  .join(" · ");
---

<section id={`pod-${pod.podSlug}`} class="scroll-mt-16">
  <p class="mono-meta uppercase">Pod · {pod.podDisplayName}</p>
  <h3 class="mt-2 text-2xl font-semibold tracking-tight text-ink">
    {
      copy ? (
        <a
          class="underline decoration-line-soft underline-offset-4 hover:decoration-accent"
          href={copy.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          {copy.title}
        </a>
      ) : (
        pod.podFullName
      )
    }
  </h3>
  {
    copy?.blurb && (
      <p class="mt-4 max-w-3xl text-[0.95rem] leading-relaxed text-body">
        {copy.blurb}
      </p>
    )
  }
  <p class="mono-meta mt-3">{strapline}</p>

  <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_2fr]">
    <div>
      <h4 class="text-[0.95rem] font-semibold text-ink">Shipped</h4>
      <p class="mono-meta mt-1">commitments signed off as delivered</p>
      <ul class="mt-4 space-y-3">
        {
          shipped.map((commitment) => (
            <li class="rounded-lg border border-line bg-surface p-4">
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-sm font-medium text-ink">
                  {commitment.goalLabel}
                </span>
                <span class="mono-meta shrink-0 text-ok">
                  {commitment.statusLabel ?? "Done"}
                </span>
              </div>
              {commitment.achievedNotePublic && (
                <p class="mono-meta mt-2 leading-snug">
                  {commitment.achievedNotePublic}
                </p>
              )}
            </li>
          ))
        }
      </ul>
      {
        pod.resolvedItems > 0 && (
          <p class="mt-4 text-sm leading-relaxed text-body">
            {`The pod also closed ${pod.resolvedItems} tracked ${
              pod.resolvedItems === 1 ? "issue" : "issues"
            } in its last ${pod.reportsCounted} reviews.`}
          </p>
        )
      }
    </div>

    <div>
      <h4 class="text-[0.95rem] font-semibold text-ink">
        Key Impact / Success Metrics
      </h4>
      <p class="mono-meta mt-1">
        {
          `read live from the pod's own biweekly reviews${
            latestReport ? ` · latest ${latestReport}` : ""
          }`
        }
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          kpis.map(({ kpi, metric }) => (
            <PodMetricCard metric={metric} label={kpi.label} note={kpi.note} />
          ))
        }
      </div>
    </div>
  </div>

  <div class="mt-10">
    <h4 class="text-[0.95rem] font-semibold text-ink">In flight now</h4>
    <p class="mono-meta mt-1">
      {
        `active milestones in the current tranche${
          pod.roadmapLabel ? ` · ${pod.roadmapLabel}` : ""
        }`
      }
    </p>
    {
      pod.roadmapText && (
        <ul class="mono-meta mt-3 space-y-1">
          {pod.roadmapText.split("·").map((item) => (
            <li>{item.trim()}</li>
          ))}
        </ul>
      )
    }

    {
      open.length > 0 && (
        <>
          <h5 class="mt-8 text-[0.95rem] font-semibold text-ink">
            Commitments still open
          </h5>
          <div class="mt-3 overflow-hidden rounded-lg border border-line bg-surface">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-line">
                  <th class="mono-meta px-4 py-2.5 font-normal uppercase">
                    Commitment
                  </th>
                  <th class="mono-meta px-4 py-2.5 font-normal uppercase">
                    Target
                  </th>
                  <th class="mono-meta px-4 py-2.5 font-normal uppercase">
                    Where it stands
                  </th>
                </tr>
              </thead>
              <tbody>
                {open.map((commitment) => (
                  <tr class="border-b border-line-soft align-top last:border-0">
                    <td class="px-4 py-3 font-medium text-ink">
                      {commitment.goalLabel}
                    </td>
                    <td class="px-4 py-3 font-mono text-body">
                      {commitment.targetText ?? "—"}
                    </td>
                    <td class="px-4 py-3 leading-relaxed text-body">
                      {commitment.achievedNotePublic ?? ""}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    {
      pod.roadmapSource && (
        <p class="mono-meta mt-4 leading-relaxed">
          Tranche scope transcribed from {pod.roadmapSource}. Where each open
          commitment stands is read from the pod's own biweekly reviews.
          {pod.roadmapAmountsRedacted &&
            " Per-milestone amounts in the signed agreement are not published; the pod's total commitment is shown above."}
        </p>
      )
    }
  </div>
</section>
