---
/**
 * Karma's chat widget, running natively on this page.
 *
 * The widget is a hosted bundle that mounts its own launcher and panel and
 * talks to the Karma API directly — no iframe, so the chat is part of the page
 * rather than a window onto the app.
 *
 * Three things it needs from us:
 *
 * 1. Its stylesheet is injected unlayered at runtime, and unlayered rules beat
 *    every cascade layer. Its reset includes `.hidden { display: none }`, which
 *    would outrank Tailwind's layered utilities and hide this site's header nav
 *    (the nav is `hidden md:flex`). Moving those rules into the `karma-chat`
 *    layer — declared first in global.css, so it sits below ours — fixes that.
 *    This is why the widget was dropped during the Astro rebuild.
 *
 * 2. Its panel opens from its own launcher. The header's "Ask Karma" button
 *    clicks that launcher, and falls back to the app if it is not there.
 *
 * 3. A token, when the visitor is signed in to the app. This site has no
 *    session of its own — sign-in lives on app.filpgf.io, and Privy keeps a
 *    session in origin-scoped storage — so the app exposes a framable bridge
 *    route that hands out the access token over postMessage. The widget asks
 *    the bridge before every message and sends what it gets as a bearer; when
 *    the bridge has nothing to give, the message goes out anonymous, which is
 *    what every failure here degrades to.
 */
import { ASK_KARMA, EXTERNAL, IDENTITY_HINT, KARMA, TOKEN_BRIDGE } from "../data/site";

const communityId = "filecoin";

/* The widget posts to this URL as given — it is the endpoint, not an API root. */
const AGENT_STREAM_PATH = "/v2/agent/stream";
const apiOrigin = import.meta.env.PUBLIC_KARMA_API_ORIGIN ?? KARMA.apiHost;
/* Lets a local build of the widget be loaded instead of the published one —
   the same escape hatch PUBLIC_KARMA_API_ORIGIN gives for the API, and the only
   way to exercise a widget change before it ships. */
const widgetOrigin =
  import.meta.env.PUBLIC_KARMA_WIDGET_ORIGIN ?? KARMA.widgetHost;
const appOrigin = import.meta.env.PUBLIC_APP_ORIGIN ?? EXTERNAL.app;

/*
 * What the composer says about whose answers these are.
 *
 * The bridge is only framed when the identity hint says someone is signed in:
 * it loads the app's auth stack, which is a lot to pay on behalf of a visitor
 * who has no session to recover. The hint is display-only and may be stale,
 * so it decides whether to *try*, never what the visitor gets — the bridge
 * re-derives the session from Privy and says for itself whether anyone is
 * signed in. A stale hint costs one wasted frame, and an anonymous answer.
 */
const CHAT_NOTICE = {
  signedOut: {
    text: "Answers here are general.",
    actionLabel: "Sign in for personalized answers",
    actionHref: `${appOrigin}/?login=true`,
  },
  /* The hint said signed in, but the bridge could not confirm it — session
     expired, or the frame never answered. The app is where that gets sorted. */
  unconfirmed: {
    text: "Answers here are general.",
    actionLabel: "Ask in the app for personalized answers",
    actionHref: `${appOrigin}/ask-karma`,
  },
} as const;
/* When the bridge confirms a session there is no notice at all: the answers
   are the visitor's own, which needs no caveat, and the app's panel shows
   nothing there either. */
---

<script
  is:inline
  define:vars={{
    scriptSrc: `${widgetOrigin}/widget/karma-chat.js`,
    apiUrl: `${apiOrigin}${AGENT_STREAM_PATH}`,
    communityId,
    /* The panel's own title, which is the app's — the header button keeps
       ASK_KARMA.label. The two are different things: one names the control,
       the other names who is answering. */
    title: "Karma Assistant",
    placeholder: "Ask about Filecoin grants, programs, or applications...",
    fallbackHref: ASK_KARMA.href,
    chatNotice: CHAT_NOTICE,
    hintCookie: IDENTITY_HINT.cookie,
    bridgeUrl: `${appOrigin}${TOKEN_BRIDGE.path}`,
    bridgeMessages: TOKEN_BRIDGE.messages,
    bridgeHandshakeTimeoutMs: TOKEN_BRIDGE.handshakeTimeoutMs,
    bridgeRequestTimeoutMs: TOKEN_BRIDGE.requestTimeoutMs,
  }}
>
  (() => {
    const LAYER = "karma-chat";
    let ready = false;

    /*
       The widget appends its stylesheet to <head> on init.
 
       A bundle whose utilities carry a `.karma-chat` scope needs nothing from
       us: its rules cannot match anything outside the widget, and inside it
       they outrank this site's same-named utilities on specificity.
 
       An older, unscoped bundle emits bare `.hidden`, `.bg-card` and friends
       into the same global namespace this site's Tailwind uses, and the two
       then fight whichever way they are ordered. Dropping it into the layer
       named first in global.css settles that in this site's favour, which
       keeps the header nav visible — at the cost of the site repainting the
       widget's panel. That trade is only worth making when there is no scope.
    */
    const contain = () => {
      const sheet = document.querySelector("style[data-karma-chat]");
      if (!sheet || sheet.dataset.layered === "true") return;
      if (sheet.textContent.includes(".karma-chat .")) return;
      sheet.textContent = `@layer ${LAYER} {${sheet.textContent}}`;
      sheet.dataset.layered = "true";
    };

    /*
       Opening the panel.

       The current bundle exposes `open()`, which is the only way in once the
       floating button is suppressed — there is no launcher left to click.
       The published bundle predates both, so the old path stays as a fallback
       until it ships: there, the floating button still exists and clicking it
       is what opens the panel.
    */
    const openChat = () => {
      if (typeof window.KarmaChat?.open === "function") {
        window.KarmaChat.open();
        return true;
      }
      const launcher = document.querySelector(".karma-chat button");
      if (!launcher) return false;
      launcher.click();
      return true;
    };

    const load = () =>
      new Promise((resolve, reject) => {
        if (window.KarmaChat) return resolve();
        const script = document.createElement("script");
        script.src = scriptSrc;
        script.async = true;
        script.addEventListener("load", () => resolve());
        script.addEventListener("error", () =>
          reject(new Error("karma-chat failed to load")),
        );
        document.head.appendChild(script);
      });

    /*
       The token bridge.

       One hidden frame of the app's bridge route, mounted on demand. It is
       trusted on exactly one thing: its origin. Every message is checked
       against the origin the frame was created for, and every request is
       posted to that origin alone — a frame that navigated elsewhere can
       neither read a request nor forge an answer.

       Two timeouts bound the cost of it not working: the handshake (frame
       load plus Privy rehydration) and each request. Both resolve to "no
       token", which the widget treats as an anonymous message — there is no
       error path, because the visitor-grade answer is the right fallback for
       every way this can fail.
    */
    const bridge = (() => {
      const origin = new URL(bridgeUrl).origin;
      const pending = new Map();
      let frame = null;
      let handshake = null;
      let state = null;
      let settleHandshake = null;

      const listeners = new Set();

      window.addEventListener("message", (event) => {
        if (event.origin !== origin) return;
        const data = event.data;
        if (!data || typeof data !== "object") return;
        if (data.type === bridgeMessages.ready) {
          state = { authenticated: data.authenticated === true };
          settleHandshake?.(state);
          for (const listener of listeners) listener(state);
          return;
        }
        if (data.type === bridgeMessages.response && pending.has(data.id)) {
          pending.get(data.id)(typeof data.token === "string" ? data.token : null);
          pending.delete(data.id);
        }
      });

      /* Mount the frame and wait for its first `ready`. Idempotent: later
         callers share the same promise, and the frame is never recreated. */
      const mount = () => {
        if (handshake) return handshake;
        handshake = new Promise((resolve) => {
          settleHandshake = resolve;
          setTimeout(() => resolve(state), bridgeHandshakeTimeoutMs);
        });
        frame = document.createElement("iframe");
        frame.src = bridgeUrl;
        frame.title = "Karma session bridge";
        frame.setAttribute("aria-hidden", "true");
        frame.tabIndex = -1;
        frame.style.cssText =
          "position:absolute;width:0;height:0;border:0;visibility:hidden";
        document.body.appendChild(frame);
        return handshake;
      };

      const getToken = async () => {
        const confirmed = await mount();
        if (!confirmed || !frame?.contentWindow) return null;
        return new Promise((resolve) => {
          const id = crypto.randomUUID();
          pending.set(id, resolve);
          frame.contentWindow.postMessage(
            { type: bridgeMessages.request, id },
            origin,
          );
          setTimeout(() => {
            if (pending.delete(id)) resolve(null);
          }, bridgeRequestTimeoutMs);
        });
      };

      /* Called on every `ready` the bridge sends — the first, and each later
         flip of the signed-in state (sign-out in another tab, for one). */
      const onState = (listener) => {
        listeners.add(listener);
        if (state) listener(state);
      };

      return { mount, getToken, onState };
    })();

    const start = async () => {
      if (ready) return true;
      await load();
      // Which wording applies, and whether the bridge is worth framing, depend
      // on whether the app has told this page who is signed in — the identity
      // hint — so it is read at open time rather than baked into the page,
      // which is static and cached.
      const hinted = document.cookie.includes(`${hintCookie}=`);
      /* What the composer says while the bridge is still being asked, or
         when it confirms a session: nothing. Only a refusal earns a note. */
      const noticeFor = (session) =>
        !hinted
          ? chatNotice.signedOut
          : session && !session.authenticated
            ? chatNotice.unconfirmed
            : undefined;
      /* The bundle gained setNotice() later than init(); against an older
         bundle the note has to be right at init, which means waiting for the
         handshake first — the panel opens up to a handshake-timeout late, but
         never says the wrong thing. */
      const canUpdate = typeof window.KarmaChat.setNotice === "function";
      if (hinted) {
        const handshake = bridge.mount();
        if (canUpdate) {
          bridge.onState((session) => window.KarmaChat.setNotice(noticeFor(session)));
          handshake.then((session) => {
            if (!session) window.KarmaChat.setNotice(chatNotice.unconfirmed);
          });
        } else {
          await handshake;
        }
      }
      window.KarmaChat.init({
        apiUrl,
        communityId,
        title,
        placeholder,
        /* Asked before every message, so a token that expires mid-conversation
           is refreshed by Privy rather than sent stale. */
        getAuthToken: hinted ? bridge.getToken : undefined,
        notice: canUpdate || !hinted ? noticeFor(null) : noticeFor(await bridge.mount()),
        /* The same header the app's panel draws: Karma's mark, its title, and
           the badge naming the context the answers are scoped to. This site is
           Karma's own surface for Filecoin, not a third party embedding the
           widget, so the mark is ours to stamp. */
        brand: "karma",
        badge: "Community",
        emptyDescription:
          "Ask me about Filecoin grants, programs, or applications.",
        /* Follows this site's own toggle, not the OS preference. */
        theme: "auto",
        /* No floating button: this site has its own trigger in the header, and
           two entry points to the same panel is one more than it needs. The
           panel hangs from under the 4rem header instead, as it does in the
           app. */
        placement: "anchored",
      });
      contain();
      ready = true;
      return true;
    };

    // Load on first idle rather than at parse time: it is a large bundle and
    // nothing above the fold depends on it.
    const idle = window.requestIdleCallback ?? ((fn) => setTimeout(fn, 2000));
    idle(() => {
      start().catch(() => {
        /* Left to the header button, which falls back to the app. */
      });
    });

    for (const trigger of document.querySelectorAll("[data-karma-chat-open]")) {
      trigger.addEventListener("click", async (event) => {
        if (
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.button > 0
        )
          return;
        event.preventDefault();
        try {
          await start();
          if (openChat()) return;
        } catch {
          /* Fall through to the app. */
        }
        window.open(fallbackHref, "_blank", "noopener");
      });
    }
  })();
</script>
