---
import type { FunctionRow } from "../../data/kernel";
import { tierColor, tierName } from "./tier";

type Props = { fn: FunctionRow };
const { fn } = Astro.props;

/**
 * Maintainer coverage is the exposure this page exists to surface, so it takes
 * the tier colour; a missing health metric is a harder failure and goes red.
 * Free-text notes stay neutral.
 */
type Flag = { text: string; tone: "tier" | "bad" | "muted" };

const flags: Flag[] = [
  fn.noMaintainer
    ? { text: "no maintainer", tone: "tier" as const }
    : fn.singleMaintainer
      ? { text: "single maintainer", tone: "tier" as const }
      : null,
  fn.noHealthMetric ? { text: "no health metric", tone: "bad" as const } : null,
  fn.note ? { text: fn.note, tone: "muted" as const } : null,
].filter((flag): flag is Flag => flag !== null);

const flagStyle = (tone: Flag["tone"]) =>
  tone === "tier" ? `color:${tierColor(fn.tier)}` : undefined;

const flagClass = (tone: Flag["tone"]) =>
  tone === "bad" ? "text-bad" : tone === "muted" ? "text-muted" : "";
---

<article
  class="flex flex-col gap-3 rounded-lg border border-line bg-white p-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6"
>
  <div class="min-w-0">
    <p
      class="font-mono text-[0.6875rem] tracking-[0.12em] uppercase"
      style={`color:${tierColor(fn.tier)}`}
    >
      {tierName(fn.tier)} · {fn.category}
    </p>
    <h4 class="mt-1.5 text-[0.95rem] leading-snug font-semibold">{fn.name}</h4>
    {
      flags.length > 0 && (
        <p class="mt-1.5 font-mono text-xs">
          {flags.map((flag, i) => (
            <>
              {i > 0 && (
                <span class="text-muted" aria-hidden="true">
                  {" · "}
                </span>
              )}
              <span class={flagClass(flag.tone)} style={flagStyle(flag.tone)}>
                {flag.text}
              </span>
            </>
          ))}
        </p>
      )
    }
  </div>

  <div class="shrink-0 sm:w-32 sm:text-right">
    {
      fn.slaMet === null ? (
        <>
          <p class="font-mono text-lg text-muted" aria-hidden="true">
            —
          </p>
          <p class="mono-meta uppercase">No data</p>
          <p class="mt-1.5">
            <span class="inline-block rounded-full border border-line px-2.5 py-0.5 font-mono text-[0.6875rem] text-muted">
              not measured
            </span>
          </p>
        </>
      ) : (
        <>
          <p class="font-mono text-lg font-medium text-ink">{fn.slaMet}</p>
          <p class="mono-meta uppercase">SLA met · 90d</p>
          <p class="mt-1.5">
            <span class="inline-block rounded-full border border-ok/40 px-2.5 py-0.5 font-mono text-[0.6875rem] text-ok">
              <span aria-hidden="true">✓</span> meeting
            </span>
          </p>
        </>
      )
    }
  </div>
</article>
