---
import type {
  FunctionEntry,
  KernelData,
  ProjectEntry,
} from "../../data/kernel-api";
import {
  countCommitments,
  uniqueCommitments,
  WINDOW_DAYS,
} from "../../data/kernel-api";
import SectionHeader from "../SectionHeader.astro";
import InventoryCard from "./InventoryCard.astro";
import {
  type CardRow,
  type Flag,
  type Kicker,
  type MetaItem,
  PENDING_NOTE,
  TIER_ORDER,
  plural,
  teamDisplayName,
  tierColor,
  tierLabel,
} from "./inventory";

type Props = { data: KernelData };
const { data } = Astro.props;

const { functions, projects } = data;

/*
 * The freshest reading anywhere on the page. Silence is measured against it
 * rather than against today, because the sync lands a day behind and a team
 * must not be marked quiet for our own ingestion lag.
 */
const asOf =
  projects
    .flatMap((project) => project.commitments)
    .map((commitment) => commitment.latest?.date)
    .filter((date): date is string => Boolean(date))
    .sort()
    .at(-1) ?? null;

/**
 * The function↔tier lookup. A commitment names only its `kernelId`, so this is
 * how a team's rows get their tier badges.
 */
const tierOfKernel = new Map(functions.map((fn) => [fn.kernelId, fn.tier]));
const categoryOfKernel = new Map(
  functions.map((fn) => [fn.kernelId, fn.category]),
);

const slug = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

// ---------------------------------------------------------------- stat tiles

/*
 * One helper for every count on the page, so the inventory and the metrics
 * tiles can never quote different totals for the same thing.
 */
const grantRefs = new Set(projects.flatMap((p) => p.grantRefs ?? []));
const monitoredFunctions = functions.filter((fn) => fn.measured).length;
/* ChainSafe holds two awards, so team count and row count differ. */
const teams = new Set(projects.map((project) => project.team).filter(Boolean))
  .size;

const tiles = [
  {
    value: String(teams),
    label: "Teams",
    sub: "Reporting at least one metric",
  },
  {
    value: String(grantRefs.size),
    label: "Grants",
    sub: "Karma applications with a metric against them",
  },
  {
    value: String(countCommitments(projects.flatMap((p) => p.commitments))),
    label: "Metrics",
    sub: "Each collected on its own cadence",
  },
];

/*
 * The legend is the key to the uptime strip, so it reads the same fill tokens
 * the bars do. Anything else and the swatch names a colour the strip never
 * paints.
 */
const LEGEND = [
  { text: "threshold met", color: "var(--color-strip-met)" },
  { text: "threshold missed", color: "var(--color-strip-missed)" },
  { text: "measured, no threshold in force", color: "var(--color-strip-read)" },
  { text: "no defensible number", color: "var(--color-strip-novalue)" },
  { text: "our platform was down", color: "var(--color-strip-outage)" },
  { text: "no reading taken", color: "var(--color-strip-none)" },
];

// ------------------------------------------------------------- by function

const functionCard = (fn: FunctionEntry): CardRow => {
  /*
   * The rendered list is the count. The API's own `commitments` figure
   * disagrees with what joins here in both directions (7 declared against 10
   * joinable for chain-sync-state, 2 against 1 for mainnet-explorer), so every
   * number beside a card is derived from the rows inside it.
   */
  const commitments = uniqueCommitments(fn.commitments);
  const metrics = countCommitments(commitments);

  const flags: Flag[] = [];
  if (fn.isInScope === false) {
    flags.push({ text: "out of scope this term", tone: "muted" });
  }
  if (fn.maintainers === 0) {
    flags.push({ text: "no maintainer reporting", tone: "bad" });
  } else if (fn.maintainers === 1) {
    flags.push({ text: "single maintainer", tone: "warn" });
  }
  flags.push(
    metrics === 0
      ? { text: "no metric", tone: "bad" }
      : { text: plural(metrics, "metric"), tone: "muted" },
  );

  /* Exact per-award names: a function's reporting teams come from the OSO slugs
     on its own commitments, never from the ambiguous `team` slug. */
  const reporting = [
    ...new Set(commitments.map((c) => c.osoProjectSlug).filter(Boolean)),
  ].map((osoSlug) => teamDisplayName(osoSlug, null));

  /*
   * The card carries the coarse family, because the heading it sits under
   * already carries the fine one — repeating `subCategory` in both places said
   * the same word twice and left the family unstated anywhere.
   */
  const kicker: Kicker[] = [
    { text: tierLabel(fn.tier), color: tierColor(fn.tier) },
    { text: fn.category, color: "var(--color-muted)" },
  ];

  const meta: MetaItem[] = [
    {
      label: "Teams reporting",
      value: reporting.length > 0 ? reporting.join(", ") : "none yet",
    },
    /*
     * No "Domain" row. The card sits under its `subCategory` heading and
     * carries its `category` in the kicker, so the row could only repeat one of
     * the two — it existed to surface the coarse label back when the kicker
     * spent its second chip on the fine one.
     */
    {
      label: "Metrics",
      value: metrics > 0 ? String(metrics) : "none",
    },
    /* Only where it changes the reading — an in-scope function needs no row
       telling the reader that it is in scope. */
    ...(fn.isInScope === false
      ? [{ label: "Kernel scope", value: "catalogued, not funded this term" }]
      : []),
    {
      label: "Grants",
      value:
        fn.grantRefs.length > 0 ? fn.grantRefs.join(" ") : "no active grant",
    },
  ];

  return {
    id: `fn-${slug(fn.kernelId)}`,
    kicker,
    title: fn.kernelFunction,
    flags,
    coverage: fn.coverage ?? null,
    commitments,
    asOf,
    prose: fn.kernelValue,
    meta,
    emptyNote:
      "No team has committed a metric for this function yet. Until one does, its condition is not visible to this page.",
  };
};

/**
 * The one comparator every list on this panel sorts by.
 *
 * `sensitivity: "base"` so case never leads — the slate holds `drand` beside
 * `Blockscout`, and a codepoint sort files the one lowercase name after every
 * other. `numeric` so a name ending in a number sorts 2 before 10.
 */
const byText = (a: string, b: string) =>
  a.localeCompare(b, "en", { sensitivity: "base", numeric: true });

/** Tier order comes from the overview so the page cannot disagree with it. */
const tierBlocks = [...data.tiers]
  /*
   * A tier the catalogue holds nothing in gets no section. It used to render a
   * heading and an "inventory pending" note, which is a paragraph explaining an
   * absence nobody asked about — and the tier table above no longer links here
   * for it either.
   */
  .filter((tier) => tier.catalogued > 0)
  .sort((a, b) => TIER_ORDER.indexOf(a.tier) - TIER_ORDER.indexOf(b.tier))
  .map((tier) => {
    /* Only what reports: the rest would render as a card of blank figures. */
    const rows = functions.filter((fn) => fn.tier === tier.tier && fn.measured);
    /*
     * Grouped on the finer of the API's two labels. `category` is a family of
     * five — 18 of the 31 functions are "Blockchain Core & Physical Storage" —
     * so grouping on it gave Irreplaceable a single heading over all five of
     * its functions and Important a single heading over both of its, which is a
     * heading that does no work. `subCategory` splits the same tier into
     * Randomness, VM & Programmability, Networking and Proving, which is what a
     * reader is scanning for. The coarse label still appears on each card.
     */
    /*
     * Both levels alphabetical. The API returns functions in its own order, so
     * left alone the headings came out in first-appearance order — no order at
     * all to a reader, who is scanning for one name and has to read every
     * heading to know it is not there. Tier order is still the API's, because
     * that one is a ranking rather than a list.
     */
    const categories = [...new Set(rows.map((fn) => fn.subCategory))]
      .sort(byText)
      .map((category) => ({
        category,
        rows: rows
          .filter((fn) => fn.subCategory === category)
          .sort((a, b) => byText(a.kernelFunction, b.kernelFunction)),
      }));
    /*
     * Catalogued and funded are different things: `important` holds two
     * functions the map lists and Kernel does not fund this term. Read off each
     * function's own `isInScope` rather than the tier, so a mixed tier says so.
     */
    const outOfScope = rows.filter((fn) => fn.isInScope === false).length;
    return { tier, rows, categories, outOfScope };
  });

// -------------------------------------------------------------- by project

/**
 * ChainSafe holds two awards and both arrive as `team: "chainsafe"`, so the
 * award's OSO slug is what tells the two rows apart and what carries a real
 * display name.
 */
const teamName = (project: ProjectEntry) =>
  teamDisplayName(project.osoProjectSlug, project.team);

const projectCard = (project: ProjectEntry): CardRow => {
  const commitments = uniqueCommitments(project.commitments);
  const metrics = countCommitments(commitments);

  const kernelsByTier = new Map<string, Set<string>>();
  const kernelIds = new Set<string>();
  const domains = new Set<string>();
  for (const commitment of commitments) {
    kernelIds.add(commitment.kernelId);
    const tier = tierOfKernel.get(commitment.kernelId);
    if (tier) {
      const seen = kernelsByTier.get(tier) ?? new Set<string>();
      seen.add(commitment.kernelId);
      kernelsByTier.set(tier, seen);
    }
    const category = categoryOfKernel.get(commitment.kernelId);
    if (category) domains.add(category);
  }

  const counted = TIER_ORDER.filter((tier) => kernelsByTier.has(tier)).map(
    (tier) => ({
      text: `${kernelsByTier.get(tier)!.size} ${tierLabel(tier).toUpperCase()}`,
      color: tierColor(tier),
    }),
  );
  /* A team whose commitments name no catalogued function still declares tiers. */
  const kicker: Kicker[] =
    counted.length > 0
      ? counted
      : project.tiers.map((tier) => ({
          text: tierLabel(tier).toUpperCase(),
          color: tierColor(tier),
        }));

  /*
   * What the row is for, not what it cost. The award led this line and set the
   * bar's width, which ranked teams by budget down a page about whether their
   * work is being watched — and put a number on a monitoring row that the
   * monitoring notebook does not carry at all.
   */
  const flags: Flag[] = [
    {
      text: plural(metrics, "metric"),
      tone: metrics === 0 ? "bad" : "ink",
    },
    { text: plural(kernelIds.size, "kernel function"), tone: "muted" },
  ];
  if (project.grantRefs.length > 0) {
    flags.push({ text: project.grantRefs.join(" · "), tone: "muted" });
  }

  const meta: MetaItem[] = [
    {
      label: "Kernel functions",
      value: String(kernelIds.size),
    },
    {
      label: "Domains",
      value: domains.size > 0 ? [...domains].join(", ") : "none catalogued",
    },
    {
      label: "Metrics",
      value: metrics > 0 ? String(metrics) : "none",
    },
    {
      label: project.grantRefs.length === 1 ? "Grant" : "Grants",
      value:
        project.grantRefs.length > 0
          ? project.grantRefs.join(" ")
          : "no award this batch",
    },
    {
      label: "OSO project",
      value: project.osoProjectSlug ?? "unmapped",
    },
  ];

  /* Named from the function catalogue, so the row cannot invent a function the
     inventory below does not also list. */
  const evidenced = [...kernelIds]
    .map((kernelId) => functions.find((fn) => fn.kernelId === kernelId))
    .filter((fn) => fn !== undefined)
    .map((fn) => ({ tier: fn.tier, name: fn.kernelFunction }))
    .sort((a, b) => byText(a.name, b.name));

  return {
    id: `team-${slug(project.projectUID.slice(2, 10))}-${slug(teamName(project))}`,
    kicker,
    title: teamName(project),
    flags,
    evidenced,
    coverage: project.coverage ?? null,
    asOf,
    commitments,
    meta,
    emptyNote:
      "This team reports no commitment in the current window. Nothing here is judged until one lands.",
  };
};

/*
 * By name, not by award. The list is read to find one team — a reader arrives
 * knowing which — and alphabetical is the only order that can be scanned
 * without reading every row. Award-descending put the largest grant first,
 * which ranked teams by budget on a page about whether the work is being
 * measured, and told a reader looking for `drand` nothing about where to look.
 */
const byNameAsc = (a: ProjectEntry, b: ProjectEntry) =>
  byText(teamName(a), teamName(b));

const projectGroup = {
  title: "Funded this batch",
  subtitle:
    "Each row is one Karma application and the metrics it pays for. Cross-checks nobody is paid for are in the by-function view, beside the funded reading they corroborate.",
  rows: [...projects].sort(byNameAsc),
};
---

<div>
  {
    /* The intro carries markup, which the `intro` prop cannot, so it is slotted. */
  }
  <SectionHeader eyebrow="Inventory" title="The inventory">
    <p class="mt-4 max-w-2xl text-base leading-relaxed sm:text-lg">
      The same commitments, read two ways. <strong
        class="font-semibold text-ink">By project</strong
      > asks what each funded team is on the hook for; <strong
        class="font-semibold text-ink">by function</strong
      > asks what the network needs and whether anyone is watching it. The percentage
      is reading coverage — the share of the periods a metric's own cadence expects
      that carry a value over the last {WINDOW_DAYS} days, counted from the day unattended
      collection started rather than from before anyone was watching, with days lost
      to an outage of our own platform excluded outright. Open any row for the metrics
      behind it — what is collected, when, and every reading taken.
    </p>
  </SectionHeader>

  <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2">
    {
      LEGEND.map((item) => (
        <li class="mono-meta flex items-center gap-2">
          <span
            class="inline-block h-2.5 w-2.5 rounded-[2px]"
            style={`background:${item.color}`}
            aria-hidden="true"
          />
          {item.text}
        </li>
      ))
    }
  </ul>

  <fieldset class="mt-8 border-0 p-0">
    <legend class="sr-only">Read the inventory by</legend>

    {
      /* CSS-only tabs: the radios drive both the labels and the panels through
        sibling selectors, so the section works with JavaScript disabled. */
    }
    <input
      class="sr-only"
      type="radio"
      name="inventory-view"
      id="inv-tab-project"
      checked
    />
    <input
      class="sr-only"
      type="radio"
      name="inventory-view"
      id="inv-tab-function"
    />

    <div class="inv-tabs flex flex-wrap gap-6 border-b border-line">
      <label
        class="inv-tab flex cursor-pointer items-center gap-2 pb-2 font-mono text-xs tracking-[0.12em] text-muted uppercase"
        data-tab="project"
        for="inv-tab-project"
      >
        By project
        <span
          class="rounded-full border border-line px-2 py-0.5 font-mono text-[0.6875rem] tracking-normal text-muted"
          >{projects.length}</span
        >
      </label>
      <label
        class="inv-tab flex cursor-pointer items-center gap-2 pb-2 font-mono text-xs tracking-[0.12em] text-muted uppercase"
        data-tab="function"
        for="inv-tab-function"
      >
        By function
        <span
          class="rounded-full border border-line px-2 py-0.5 font-mono text-[0.6875rem] tracking-normal text-muted"
          >{monitoredFunctions}</span
        >
      </label>
    </div>

    <div class="inv-panel" data-panel="project">
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {
          tiles.map((tile) => (
            <div class="rounded-lg border border-line bg-surface p-4">
              <p class="font-mono text-2xl font-medium text-ink">
                {tile.value}
              </p>
              <p class="mt-1 text-[0.8125rem] text-ink">{tile.label}</p>
              <p class="mono-meta mt-2">{tile.sub}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10">
        <section aria-labelledby="inv-group-funded">
          <div
            class="flex items-baseline justify-between gap-4 border-b border-line pb-2"
          >
            <h3
              id="inv-group-funded"
              class="font-mono text-xs font-medium tracking-[0.14em] text-ink uppercase"
            >
              {projectGroup.title}
            </h3>
            <p class="mono-meta shrink-0">
              {plural(projectGroup.rows.length, "row")}
            </p>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-body">
            {projectGroup.subtitle}
          </p>
          <ul class="mt-4 space-y-3">
            {
              projectGroup.rows.map((project) => (
                <li>
                  <InventoryCard {...projectCard(project)} />
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>

    <div class="inv-panel" data-panel="function">
      <div class="mt-8 space-y-12">
        {
          tierBlocks.map(({ tier, rows, categories, outOfScope }) => (
            <section aria-labelledby={`inv-tier-${tier.tier}`}>
              <div
                class="flex items-baseline justify-between gap-4 border-b pb-2"
                style={`border-color:${tierColor(tier.tier)}`}
              >
                <h3
                  id={`inv-tier-${tier.tier}`}
                  class="font-mono text-xs font-medium tracking-[0.14em] uppercase"
                  style={`color:${tierColor(tier.tier)}`}
                >
                  {tierLabel(tier.tier)}
                </h3>
                <p class="mono-meta shrink-0">
                  {rows.length === 0
                    ? "nothing monitored"
                    : `${rows.length} monitored`}
                </p>
              </div>

              {outOfScope > 0 && rows.length > 0 && (
                <p class="mt-4 rounded-md border border-line bg-surface px-4 py-3 font-mono text-xs leading-relaxed text-muted">
                  {outOfScope === rows.length
                    ? "Catalogued so the map is complete, but out of scope for Kernel this term — the programme does not fund these functions in the current batch."
                    : `${plural(outOfScope, "function")} here ${outOfScope === 1 ? "is" : "are"} catalogued but out of scope for Kernel this term — the map lists ${outOfScope === 1 ? "it" : "them"}; the programme does not fund ${outOfScope === 1 ? "it" : "them"} in the current batch.`}
                </p>
              )}

              {tier.catalogued === 0 || rows.length === 0 ? (
                <p class="mt-4 rounded-md border border-line bg-surface px-4 py-3 font-mono text-xs leading-relaxed text-muted">
                  {PENDING_NOTE[tier.tier] ??
                    "Functions in this tier have not been inventoried yet."}
                </p>
              ) : (
                <>
                  {categories.map((group) => (
                    <div class="mt-6">
                      <p class="mono-meta uppercase">{group.category}</p>
                      <ul class="mt-3 space-y-3">
                        {group.rows.map((fn) => (
                          <li>
                            <InventoryCard {...functionCard(fn)} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}

                  {rows.length < tier.catalogued && (
                    <p class="mt-4 rounded-md border border-line bg-surface px-4 py-3 font-mono text-xs leading-relaxed text-muted">
                      {plural(
                        tier.catalogued - rows.length,
                        "further function",
                      )}{" "}
                      in this tier{" "}
                      {tier.catalogued - rows.length === 1 ? "is" : "are"}{" "}
                      catalogued with no metric reporting against{" "}
                      {tier.catalogued - rows.length === 1 ? "it" : "them"} yet.
                    </p>
                  )}
                </>
              )}
            </section>
          ))
        }
      </div>
    </div>
  </fieldset>
</div>

<style>
  /*
   * Sibling selectors off the radios, not `:has()` or a script: the checked
   * input precedes both the tab strip and the panels, so one rule set drives
   * the underline and the visibility with no JS at all.
   */
  .inv-panel {
    display: none;
  }

  #inv-tab-project:checked ~ [data-panel="project"],
  #inv-tab-function:checked ~ [data-panel="function"] {
    display: block;
  }

  /*
   * A deep link from the tier table lands on a heading inside the by-function
   * panel, which the by-project tab hides. Without this the hash would resolve
   * to a `display:none` element and the page would sit still. `:target` beats
   * the radio here, so the link works before the enhancement script runs and
   * still works if it never does.
   */
  fieldset:has([data-panel="function"] :target) [data-panel="project"] {
    display: none;
  }

  fieldset:has([data-panel="function"] :target) [data-panel="function"] {
    display: block;
  }

  .inv-tab {
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }

  #inv-tab-project:checked ~ .inv-tabs [data-tab="project"],
  #inv-tab-function:checked ~ .inv-tabs [data-tab="function"] {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  /* The underline has to follow the panel the `:target` rule above swapped in. */
  fieldset:has([data-panel="function"] :target) .inv-tabs [data-tab="project"] {
    color: var(--color-muted);
    border-bottom-color: transparent;
  }

  fieldset:has([data-panel="function"] :target)
    .inv-tabs
    [data-tab="function"] {
    color: var(--color-ink);
    border-bottom-color: var(--color-accent);
  }

  /*
   * The sticky header would otherwise sit on top of the heading a deep link
   * just scrolled to.
   */
  [data-panel="function"] section[aria-labelledby] {
    scroll-margin-top: 6rem;
  }

  /* The inputs are visually hidden, so the focus ring has to move to the label. */
  #inv-tab-project:focus-visible ~ .inv-tabs [data-tab="project"],
  #inv-tab-function:focus-visible ~ .inv-tabs [data-tab="function"] {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>

<script>
  /*
   * The one way into a tier from elsewhere on the page — the tier table above
   * calls it. Kept here rather than there because everything it has to know
   * about (which panel holds the headings, which radio selects it) is this
   * component's business.
   */
  declare global {
    interface Window {
      openInventoryTier?: (id: string) => void;
    }
  }

  window.openInventoryTier = (id: string) => {
    const heading = document.getElementById(id);
    const section = heading?.closest("section");
    if (!section) return;

    // Select the panel before measuring: a hidden section has no position, so
    // scrolling to it first would land on 0.
    const tab = document.getElementById("inv-tab-function");
    if (tab instanceof HTMLInputElement) tab.checked = true;

    /*
     * The hash is set without a navigation so the `:target` rule stays in
     * agreement with the radio, and so the tier is shareable — but pushing it
     * would scroll first and undo the smooth scroll below.
     */
    history.replaceState(null, "", `#${id}`);
    section.scrollIntoView({
      behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ? "auto"
        : "smooth",
      block: "start",
    });
  };

  /* A deep link arriving from outside the page gets the same treatment. */
  const openFromHash = () => {
    const id = location.hash.slice(1);
    if (id.startsWith("inv-tier-")) window.openInventoryTier?.(id);
  };

  openFromHash();
  window.addEventListener("hashchange", openFromHash);
</script>
