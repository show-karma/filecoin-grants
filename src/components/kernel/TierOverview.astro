---
import type { KernelData } from "../../data/kernel-api";
import { TIERS } from "../../data/kernel";
import { tierColor } from "./tier";

type Props = {
  /** Null when the Kernel API was unreachable at build time. */
  data?: KernelData | null;
};

const { data = null } = Astro.props;

/**
 * One row of the table, for every tier the API has catalogued something in.
 * Only the tier's name, rule and posture are editorial —
 * they are definitions, true whether or not anything is running. Every figure
 * comes from the API or is not shown: with no live row the numeric cells go to
 * their unknown state rather than to a remembered one, because a table that
 * quotes last year's percentages during an outage is worse than a blank one.
 *
 * `functions` is null for a tier nothing has been catalogued in yet — the row
 * then says Pending rather than a confident zero, because "no functions" and
 * "nobody has written the functions down" are different claims.
 * `coverage` is null until the API reports one, which renders as an em dash.
 * It must never round down to 0%: "nothing collected yet" and "the collection
 * is failing" are different claims and the table has to keep them apart.
 */
const rows = TIERS.map((tier) => {
  const live = data?.tiers.find((row) => row.tier === tier.apiId);

  return {
    tier,
    /*
     * A tier the API has catalogued nothing in is dropped from the table.
     * `nice-to-have` has held zero functions since the programme started, and
     * the row it produced was four cells of nothing — Pending, an em dash,
     * "Nothing collected" — under a heading that promises a count.
     *
     * The test is on the served number, not on the absence of one: with the API
     * unreachable every tier is `null` and the table keeps them all, because
     * "we could not ask" is not the same claim as "there is nothing there".
     * It also means the row comes back on its own the day something is
     * catalogued, rather than waiting on someone to remember this file.
     */
    empty: live ? live.catalogued === 0 : false,
    /* The tier's own heading in the inventory below. */
    href: live ? `#inv-tier-${live.tier}` : null,
    functions: live ? live.catalogued || null : null,
    /*
     * The inventory below lists every catalogued function in the tier, in
     * scope or not, so "all listed" is the honest sub-label — except where
     * some of them sit outside Kernel's scope, which the count alone would
     * quietly read as "funded here".
     */
    listedLabel:
      live && live.inScope < live.catalogued
        ? live.inScope === 0
          ? "None in scope"
          : `${live.inScope} in scope`
        : "All listed",
    coverage:
      live?.coverage && live.coverage.pct !== null
        ? `${live.coverage.pct.toFixed(1)}%`
        : null,
    /*
     * The sub-label under the percentage, and deliberately not the fraction the
     * percentage is computed from. Periods-read-of-periods-promised is a claim
     * about the collector and stays high by construction: a tier reporting on
     * one function out of five still reads 100%. What a reader needs beside
     * that number is how much of the tier it speaks for, so the sub-label
     * counts functions with a reporter, and the two together say "complete,
     * over very little".
     */
    coverageDetail: live ? `${live.measured} of ${live.catalogued} reporting` : null,
  };
}).filter((row) => !row.empty);
---

<!--
  The table keeps its full width and scrolls horizontally on small screens.
  tabindex/role make the scroll container reachable by keyboard, which a bare
  overflow container is not.
-->
<div
  class="overflow-x-auto"
  tabindex="0"
  role="region"
  aria-label="Kernel tier overview"
>
  <table class="w-full min-w-[46rem] border-collapse text-left">
    <thead>
      <tr class="border-b border-ink">
        <th scope="col" class="mono-meta pb-2.5 uppercase">Tier</th>
        <th scope="col" class="mono-meta pb-2.5 uppercase">Functions</th>
        <th scope="col" class="mono-meta pb-2.5 uppercase">Coverage · 90d</th>
        <th scope="col" class="mono-meta pb-2.5 uppercase">Funding posture</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          /*
             `data-href` and not a wrapping anchor: a row is four cells and
             `<a>` cannot wrap `<tr>`. The link on the tier name is the real,
             keyboard-reachable control and works with no JS; the row-level
             handler below is a convenience over the top of it.
          */
          <tr
            class:list={[
              "border-b border-line align-top",
              row.href && "tier-row cursor-pointer",
            ]}
            data-href={row.href ?? undefined}
          >
            <td class="py-5 pr-6">
              <div class="flex gap-4">
                {/*
                  A fixed-height pill, not a full-height rule: in the design it
                  runs from the top of the tier name to the end of the first
                  description line and stays that length whatever the row
                  height.
                */}
                <span
                  class="mt-1 h-11 w-[6px] shrink-0 rounded-full"
                  style={`background:${tierColor(row.tier.id)}`}
                  aria-hidden="true"
                />
                <div class="max-w-[16rem]">
                  <p class="font-semibold text-ink">
                    {row.href ? (
                      <a class="tier-link" href={row.href}>
                        {row.tier.name}
                      </a>
                    ) : (
                      row.tier.name
                    )}
                  </p>
                  <p class="mt-1 text-sm leading-snug text-body">
                    {row.tier.rule}
                  </p>
                </div>
              </div>
            </td>
            <td class="py-5 pr-6">
              {row.functions === null ? (
                <>
                  <p class="font-mono text-sm text-muted">Pending</p>
                  <p class="mono-meta mt-1 uppercase">Not inventoried</p>
                </>
              ) : (
                <>
                  <p class="font-mono text-lg font-medium text-ink">
                    {row.functions}
                  </p>
                  <p class="mono-meta mt-1 uppercase">{row.listedLabel}</p>
                </>
              )}
            </td>
            <td class="py-5 pr-6">
              {row.coverage === null ? (
                <>
                  <p class="font-mono text-lg text-muted" aria-hidden="true">
                    —
                  </p>
                  <p class="mono-meta mt-1 uppercase">Nothing collected</p>
                </>
              ) : (
                <>
                  <p class="font-mono text-lg font-medium text-ink">
                    {row.coverage}
                  </p>
                  <p class="mono-meta mt-1 uppercase">{row.coverageDetail}</p>
                </>
              )}
            </td>
            <td class="py-5 text-sm text-body">{row.tier.postureShort}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /*
   * The row reads as one target: the underline belongs to the name, but it has
   * to answer to a hover anywhere in the row, because that is where the pointer
   * will be.
   */
  .tier-link {
    color: inherit;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 120ms ease;
  }

  .tier-row:hover {
    background: var(--color-line-soft);
  }

  .tier-row:hover .tier-link,
  .tier-link:focus-visible {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }
</style>

<script>
  /*
   * Progressive enhancement over the link in each row's first cell: the whole
   * row becomes clickable, and the jump is handed to the inventory rather than
   * left to the browser. The inventory's tier headings live inside the "by
   * function" panel, which is hidden while the "by project" tab is selected —
   * a bare hash change would land on a `display:none` element and the page
   * would not move. `openInventoryTier` selects the panel first, then scrolls.
   *
   * A click that lands on a link, a button, or a text selection is left alone.
   */
  document.querySelectorAll<HTMLElement>(".tier-row[data-href]").forEach((row) => {
    row.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("a, button")) return;
      if (window.getSelection()?.toString()) return;
      const href = row.dataset.href;
      if (href) window.openInventoryTier?.(href.slice(1));
    });
  });

  document.querySelectorAll<HTMLAnchorElement>("a.tier-link").forEach((link) => {
    link.addEventListener("click", (event) => {
      const id = link.getAttribute("href")?.slice(1);
      if (!id || !window.openInventoryTier) return;
      event.preventDefault();
      window.openInventoryTier(id);
    });
  });
</script>
