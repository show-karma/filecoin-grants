---
import type { KernelData } from "../../data/kernel-api";
import { countCommitments, WINDOW_DAYS } from "../../data/kernel-api";
import type { KernelMetric } from "../../data/kernel";

type Props = {
  data: KernelData;
};

const { data } = Astro.props;
const { program } = data;

const count = (n: number, one: string, many = `${one}s`) =>
  `${n} ${n === 1 ? one : many}`;

/* One decimal always, matching the tier table above and the notebook. */
const pct = (value: number) => `${value.toFixed(1)}%`;

const metrics = countCommitments(data.projects.flatMap((p) => p.commitments));
const grantRefs = new Set(data.projects.flatMap((p) => p.grantRefs ?? []));

/* ChainSafe holds two awards, so team count and grant-row count differ. */
const teams = new Set(
  data.projects.map((project) => project.team).filter(Boolean),
).size;

/* A function with a metric written but unsigned is not one nobody has proposed
   anything for; the catalog counts them apart and so does this row. */
const proposed = program.functionsProposed ?? null;
const drafted = program.metricsDrafted ?? null;
const unscoped = program.functionsUnscoped ?? null;

/* No pass-rate tile: most readings in the window carry no threshold at all,
   and a rate over the scored minority describes a different programme. */
const coverage = program.coverage ?? null;

const tiles: KernelMetric[] = [
  {
    value: coverage && coverage.pct !== null ? pct(coverage.pct) : "—",
    label: `Reading coverage · rolling ${count(WINDOW_DAYS, "day")}`,
    note: coverage
      ? `${coverage.received} of ${coverage.expected} expected reading periods carry a value`
      : "Nothing collected in this window",
    noteTone: coverage ? "muted" : "warn",
  },
  {
    value: `${metrics}`,
    label: "Metrics collected",
    note: `${count(teams, "team")} · ${count(grantRefs.size, "grant row")}`,
  },
  {
    value: proposed === null ? "—" : `${proposed}`,
    label: `${proposed === 1 ? "Function" : "Functions"} with metrics proposed`,
    note:
      drafted === null
        ? "Awaiting a signed appendix"
        : `${count(drafted, "metric")} drafted, awaiting a signed appendix`,
    noteTone: "warn",
  },
  {
    value: unscoped === null ? "—" : `${unscoped}`,
    label: `${unscoped === 1 ? "Function" : "Functions"} not yet scoped`,
    note: "No metric proposed against them yet",
    noteTone: "warn",
  },
  {
    value: `${program.singleMaintainerCritical}`,
    label: `Top-tier ${
      program.singleMaintainerCritical === 1 ? "function is" : "functions are"
    } measured through one team only`,
    note: "Posture calls for 2+ implementations",
    noteTone: "warn",
  },
];
---

{
  /*
  Five tiles, 3 + 2 on a wide screen — the shape the monitoring notebook uses.
  The <dl> constraint holds: only <dt>/<dd> groups may sit here, never a
  placeholder element to square the grid off. Within each group the <dt> leads
  in the DOM and `order` lifts the figure above it visually.
*/
}
<dl
  class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2 lg:grid-cols-3"
>
  {
    tiles.map((metric) => (
      <div class="flex flex-col bg-surface p-5">
        <dt class="order-2 mt-1.5 text-sm leading-snug text-body">
          {metric.label}
        </dt>
        <dd
          class:list={[
            "order-1 font-mono text-2xl font-medium tracking-tight",
            metric.value === "—" ? "text-muted" : "text-ink",
          ]}
        >
          {metric.value}
        </dd>
        <dd
          class:list={[
            "order-3 mt-2 font-mono text-xs leading-snug",
            metric.noteTone === "warn" ? "text-warn" : "text-muted",
          ]}
        >
          {metric.note}
        </dd>
      </div>
    ))
  }
</dl>
