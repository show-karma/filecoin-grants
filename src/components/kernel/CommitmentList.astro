---
import type { Commitment } from "../../data/kernel-api";
import CommitmentBlock from "./CommitmentBlock.astro";
import { pluralize } from "./uptime";

type Props = { commitments: Commitment[] };
const { commitments } = Astro.props;

/*
 * One list. Health commitments and growth counters used to be ranked apart,
 * on the grounds that a counter carries no threshold and so no verdict —
 * but neither does any health commitment whose appendix is still unsigned,
 * which is most of them. The split named a distinction the cards themselves
 * never showed, and it made a reader count two totals to answer "what is
 * collected here".
 *
 * Not "a threshold, met or missed" in the note either: the header promised a
 * verdict the cards below it do not all carry. It says what the metrics are
 * collected on instead, which is the claim the page can actually make.
 */
const note = `${commitments.length} ${pluralize(commitments.length, "metric")} · measured on a cadence, judged by nothing yet`;
---

{
  commitments.length === 0 ? (
    <p class="mono-meta">no metrics reported</p>
  ) : (
    <section>
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line pb-2">
        <h4 class="text-[0.95rem] font-semibold">Metrics</h4>
        <p class="mono-meta">{note}</p>
      </div>
      <div class="mt-4 space-y-4">
        {commitments.map((commitment) => (
          <CommitmentBlock commitment={commitment} />
        ))}
      </div>
    </section>
  )
}
