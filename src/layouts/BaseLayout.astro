---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE } from "../data/site";
import { MAIN_NAV, type NavEntry } from "../data/nav";
import Analytics from "@vercel/analytics/astro";

type Props = {
  title: string;
  description?: string;
  /** Section nav for this page. Defaults to the landing-page nav. */
  nav?: NavEntry[];
  cta?: { label: string; href: string };
  /** Renders "filpgf.io / Kernel" in place of the plain wordmark. */
  breadcrumb?: string;
  /** Program accent, applied to eyebrows and rules across the page. */
  accent?: "default" | "kernel" | "rd" | "rev";
  ogType?: "website" | "article";
};

const {
  title,
  description = SITE.description,
  nav = MAIN_NAV,
  cta,
  breadcrumb,
  accent = "default",
  ogType = "website",
} = Astro.props;

/**
 * Program pages override --color-accent so every eyebrow, rule and link picks
 * up their colour. "default" deliberately emits no override — pointing the
 * token at itself would be a self-referential cycle and unset it.
 */
const ACCENTS: Record<string, string | undefined> = {
  default: undefined,
  kernel: "var(--color-accent-kernel)",
  rd: "var(--color-accent-rd)",
  rev: "var(--color-accent-rev)",
};

const accentStyle = ACCENTS[accent]
  ? `--color-accent: ${ACCENTS[accent]}`
  : undefined;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
---

<!doctype html>
<html lang="en" style={accentStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /*
      Theme, resolved before the first paint so the page never flashes light.
      Must stay `is:inline`: a bundled module script runs after paint. The
      "theme" key holds "light" or "dark"; absent means follow the system.
    */
    }
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage can be unavailable (private browsing); fall back to the OS.
        }
        const dark =
          stored === "dark" ||
          (stored === null &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        // Also state the resolved theme outright. The class alone only ever
        // says "dark": in light mode the element carries nothing, which reads
        // the same as "this page has no opinion" to anything watching from
        // outside — the embedded chat widget among them, which then fell back
        // to the OS preference and rendered a dark panel on a light page.
        document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      /*
      One icon candidate only. Offering an SVG alongside a raster let browsers
      pick different files and show different marks per browser; this is the
      same ICO the app serves, so both properties share a tab icon.
    */
    }
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    {
      /* No share image ships yet — upgrade to summary_large_image once one does. */
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <slot name="head" />
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-deep focus:px-4 focus:py-2 focus:text-sm focus:text-white"
    >
      Skip to content
    </a>
    <SiteHeader nav={nav} cta={cta} breadcrumb={breadcrumb} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <Analytics />
  </body>
</html>
